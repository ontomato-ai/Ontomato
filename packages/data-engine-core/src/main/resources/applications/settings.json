      "zh-CN": "模型、通用设置、连接、日志与监控"
    },
    "icon": "settings",
    "groups": [
      {
        "key": "models",
        "names": {
          "en": "Models",
          "zh-CN": "模型",
          "zh-TW": "模型",
          "ja": "モデル",
          "ar": "النماذج",
          "fr": "Modèles",
          "de": "Modelle",
          "it": "Modelli"
        },
        "sort": 0
      },
      {
        "key": "system-settings",
        "names": {
          "en": "System",
          "zh-CN": "系统",
          "zh-TW": "系統",
          "ja": "システム",
          "ar": "النظام",
          "fr": "Système",
          "de": "System",
          "it": "Sistema"
