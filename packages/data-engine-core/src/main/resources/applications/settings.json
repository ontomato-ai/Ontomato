        "path": "/settings/model-config/usage",
        "icon": "cpu",
        "groupKey": "models",
        "inputs": {
          "domain": { "literal": { "className": "platform:ModelUsage", "primaryKey": "domain" } }
        },
        "names": {
          "en": "Model usage",
          "zh-CN": "模型用途",
          "zh-TW": "模型用途",
          "ja": "モデル用途",
          "de": "Modellverwendung",
          "fr": "Utilisation des modèles",
          "it": "Utilizzo dei modelli",
          "ar": "استخدام النماذج"
        },
        "descriptions": {
          "en": "Configure domain default chat and embedding models, vector rebuilds, and background task models",
          "zh-CN": "配置域默认对话模型、向量模型、向量索引重建及系统后台工序模型"
        }
      },
      {
        "id": "model-connections",
        "pageKey": "model-connections",
        "panelId": "builtin-product-model-connections",
        "defaultAgent": { "kind": "preset", "agentKind": "admin" },
        "path": "/settings/model-config/providers",
        "icon": "server",
        "groupKey": "models",
        "names": {
          "en": "Providers & models",
          "zh-CN": "服务商和模型",
          "zh-TW": "服務商與模型",
