      {
        "id": "system-monitor",
        "pageKey": "system-monitor",
        "kind": "native",
        "path": "/settings/records/system-monitor",
        "icon": "activity",
        "groupKey": "records",
        "names": {
          "en": "System monitoring",
          "zh-CN": "系统监控",
          "zh-TW": "系統監控",
          "ja": "システム監視",
          "ar": "مراقبة النظام",
          "fr": "Surveillance système",
          "de": "Systemüberwachung",
          "it": "Monitoraggio sistema"
        },
        "descriptions": {
          "en": "Service status and resource usage of the data engine",
          "zh-CN": "数据引擎的服务状态与资源用量",
          "zh-TW": "資料引擎的服務狀態與資源用量",
          "ja": "データエンジンのサービス状態とリソース使用量",
          "ar": "حالة خدمة محرك البيانات واستخدام الموارد",
          "fr": "État du service et ressources du moteur de données",
          "de": "Dienststatus und Ressourcennutzung der Datenengine",
          "it": "Stato del servizio e uso delle risorse del motore dati"
        }
