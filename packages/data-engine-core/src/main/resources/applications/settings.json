{
  "id": "settings",
  "kind": "native",
  "rail": "bottom",
  "category": "admin",
  "sort": 20,
  "entry": {
    "path": "/settings",
    "renderer": "settings"
  },
  "entryAccess": [
    "system-config",
    "authorization-management",
    "audit-logs",
    "system-monitoring",
    "mcp-service"
  ],
  "scheduleAdapter": null,
  "framePanelId": "builtin-product-platform-frame",
  "allowStandalone": false,
  "declaration": {
    "names": {
      "en": "System settings",
      "zh-CN": "系统设置"
    },
    "descriptions": {
      "en": "Models, general settings, connections, logs and monitoring",
      "zh-CN": "模型、通用设置、连接、日志与监控"
    },
    "icon": "settings",
    "groups": [],
    "permissions": [],
    "panelUses": [
      {
        "id": "model-usage",
        "pageKey": "model-usage",
        "panelId": "builtin-product-model-usage",
        "path": "/settings/model-config/usage",
        "access": { "permissionCode": "system-config" },
        "inputs": {
          "domain": { "literal": { "className": "platform:ModelUsage", "primaryKey": "domain" } }
        },
        "names": {
          "en": "Model usage",
          "zh-CN": "模型用途",
          "zh-TW": "模型用途",
          "ja": "モデル用途",
          "de": "Modellverwendung",
          "fr": "Utilisation des modèles",
          "it": "Utilizzo dei modelli",
          "ar": "استخدام النماذج"
        },
        "descriptions": {
          "en": "Configure domain default chat and embedding models, vector rebuilds, and background task models",
          "zh-CN": "配置域默认对话模型、向量模型、向量索引重建及系统后台工序模型"
        }
      },
      {
        "id": "model-connections",
        "pageKey": "model-connections",
        "panelId": "builtin-product-model-connections",
        "path": "/settings/model-config/providers",
        "access": { "permissionCode": "system-config" },
        "names": {
          "en": "Providers & models",
          "zh-CN": "服务商和模型",
          "zh-TW": "服務商與模型",
          "ja": "プロバイダーとモデル",
          "de": "Anbieter & Modelle",
          "fr": "Fournisseurs et modèles",
          "it": "Provider e modelli",
          "ar": "المزودون والنماذج"
        },
        "descriptions": {
          "en": "Manage domain provider connections and public chat or embedding models",
          "zh-CN": "维护域内模型服务商连接及公开对话、向量模型"
        }
      },
      {
        "id": "general-settings",
        "pageKey": "general-settings",
        "panelId": "builtin-product-general-settings",
        "path": "/settings/system-config/general",
        "icon": "settings",
        "access": { "permissionCode": "system-config" },
        "inputs": {
          "settings": { "literal": { "className": "platform:GeneralSettings", "primaryKey": "general" } }
        },
        "names": {
          "en": "General",
          "zh-CN": "通用",
          "zh-TW": "通用",
          "ja": "一般",
          "de": "Allgemein",
          "fr": "Général",
          "it": "Generale",
          "ar": "عام"
        },
        "descriptions": {
          "en": "Knowledge recall, the DSL time limit and the data engine's language",
          "zh-CN": "知识召回条数、DSL 时限与数据引擎的语言"
        }
      },
      {
        "id": "data-adapters",
        "pageKey": "data-adapters",
        "panelId": "builtin-product-data-adapters",
        "path": "/settings/system-config/data-adapters",
        "icon": "database",
        "access": { "permissionCode": "system-config" },
        "inputs": {
          "domain": { "literal": { "className": "platform:DataAdapterConfig", "primaryKey": "domain" } }
        },
        "names": {
          "en": "Data adapters",
          "zh-CN": "数据适配器",
          "zh-TW": "資料轉接器",
          "ja": "データアダプター",
          "de": "Datenadapter",
          "fr": "Adaptateurs de données",
          "it": "Adattatori dati",
          "ar": "محولات البيانات"
        },
        "descriptions": {
          "en": "Configure the domain data adapter, multi-source routing, and connection tests",
          "zh-CN": "配置域数据适配器、多源路由规则及连接测试"
        }
      },
      {
        "id": "external-mcp",
        "pageKey": "external-mcp",
        "panelId": "builtin-product-external-mcp",
        "path": "/settings/external-mcp",
        "icon": "link",
        "access": { "permissionCode": "mcp-service" },
        "names": {
          "en": "External MCP services",
          "zh-CN": "外部 MCP 服务",
          "zh-TW": "外部 MCP 服務",
          "ja": "外部 MCP サービス",
          "de": "Externe MCP-Dienste",
          "fr": "Services MCP externes",
          "it": "Servizi MCP esterni",
          "ar": "خدمات MCP الخارجية"
        },
        "descriptions": {
          "en": "Register external MCP services that agents can call and check available tools on demand",
          "zh-CN": "登记智能体可调用的外部 MCP 服务并按需检查连通性与工具"
        }
      },
      {
        "id": "published-mcp",
        "pageKey": "published-mcp",
        "panelId": "builtin-product-published-mcp",
        "path": "/settings/mcp-services",
        "icon": "share-2",
        "access": { "permissionCode": "mcp-service" },
        "names": {
          "en": "Published MCP services",
          "zh-CN": "对外 MCP 服务",
          "zh-TW": "對外 MCP 服務",
          "ja": "公開 MCP サービス",
          "de": "Veröffentlichte MCP-Dienste",
          "fr": "Services MCP publiés",
          "it": "Servizi MCP pubblicati",
          "ar": "خدمات MCP المنشورة"
        },
        "descriptions": {
          "en": "View MCP services published by the platform, copy endpoints, and inspect available tools",
          "zh-CN": "查看平台对外开放的 MCP 服务端点、鉴权说明与可用工具"
        }
      },
      {
        "id": "audit-log",
        "pageKey": "audit-log",
        "panelId": "builtin-product-audit-log",
        "path": "/settings/records/audit-log",
        "icon": "clipboard-list",
        "access": { "permissionCode": "audit-logs" },
        "names": {
          "en": "Audit log",
          "zh-CN": "审计日志",
          "zh-TW": "稽核日誌",
          "ja": "監査ログ",
          "de": "Audit-Protokolle",
          "fr": "Journaux d'audit",
          "it": "Log audit",
          "ar": "سجلات التدقيق"
        },
        "descriptions": {
          "en": "Sign-ins and changes recorded across the platform",
          "zh-CN": "平台内的登录与变更记录"
        }
      }
    ]
  }
}
