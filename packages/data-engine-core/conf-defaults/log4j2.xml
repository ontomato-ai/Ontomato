<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">
  <Properties><Property name="FILE_PATH">${env:ONTOLOGY_LOG_DIR:-./logs}</Property></Properties>
  <Appenders>
    <Console name="ServiceConsole" target="SYSTEM_OUT"><ServiceLogLayout/></Console>
    <RollingFile name="ServiceFile" fileName="${FILE_PATH}/ontology.log" filePattern="${FILE_PATH}/ontology-%d{yyyy-MM-dd}{UTC}-%i.log">
      <ServiceLogLayout/>
      <Policies><TimeBasedTriggeringPolicy interval="1" modulate="true"/><SizeBasedTriggeringPolicy size="${serviceLog:defaults.file.maxBytes}"/></Policies>
      <DefaultRolloverStrategy fileIndex="nomax">
        <Delete basePath="${FILE_PATH}" maxDepth="1"><IfFileName glob="ontology-*.log"><IfAccumulatedFileCount exceeds="${serviceLog:archiveFiles}"/></IfFileName></Delete>
      </DefaultRolloverStrategy>
    </RollingFile>
    <Rewrite name="ServiceEvents"><ServiceLogPolicy/><AppenderRef ref="ServiceConsole"/><AppenderRef ref="ServiceFile"/></Rewrite>
  </Appenders>
  <Loggers>
    <!-- Provider HTTP debug output contains credentials and model payloads. -->
    <Logger name="dev.langchain4j.http.client.log" level="OFF"/>
    <Root level="${env:LOG_LEVEL:-INFO}"><AppenderRef ref="ServiceEvents"/></Root>
  </Loggers>
</Configuration>
