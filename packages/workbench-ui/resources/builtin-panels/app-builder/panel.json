{
  "manifest": {
    "state": {
      "app": {
        "type": { "kind": "object", "objectType": "platform:Application" },
        "default": null,
        "deepLink": true
      },
      "session": {
        "type": { "kind": "scalar", "type": "string" },
        "default": null,
        "deepLink": true
      },
      "selectedSession": {
        "type": { "kind": "object", "objectType": "platform:AgentSession" },
        "default": null
      },
      "tab": {
        "type": { "kind": "scalar", "type": "string" },
        "default": "preview",
        "deepLink": true
      },
      "file": {
        "type": { "kind": "scalar", "type": "string" },
        "default": null,
        "deepLink": true
      },
      "commit": {
        "type": { "kind": "scalar", "type": "string" },
        "default": null,
        "deepLink": true
      },
      "diffMode": {
        "type": { "kind": "scalar", "type": "string" },
        "default": "latest",
        "deepLink": true
      },
      "diffTarget": {
        "type": { "kind": "scalar", "type": "string" },
        "default": "latest"
      },
      "pane": {
        "type": { "kind": "scalar", "type": "string" },
        "default": "closed",
        "deepLink": true
      },
      "expandedApps": {
        "type": { "kind": "list", "items": { "kind": "scalar", "type": "string" } },
        "default": []
      },
      "publishDrawerOpen": {
        "type": { "kind": "scalar", "type": "boolean" },
        "default": false
      },
      "publishCommit": {
        "type": { "kind": "scalar", "type": "string" },
        "default": null
      },
      "previewEntryId": {
        "type": { "kind": "scalar", "type": "string" },
        "default": null
      },
      "previewPage": {
        "type": { "kind": "scalar", "type": "string" },
        "default": null
      },
      "editTarget": {
        "type": { "kind": "object", "objectType": "platform:Application" },
        "default": null
      },
      "createDialogOpen": {
        "type": { "kind": "scalar", "type": "boolean" },
        "default": false
      },
      "editDialogOpen": {
        "type": { "kind": "scalar", "type": "boolean" },
        "default": false
      }
    },
    "members": {
      "projects": {
        "id": "builtin-product-app-builder-projects",
        "component": "ObjectList",
        "type": "platform:Application",
        "data": { "rows": "builderProjects" },
        "state": { "selected": "app", "expandedKeys": "expandedApps" },
        "operations": {
          "deleteDraft": "applications.deleteDraft",
          "deletePublished": "applications.delete"
        },
        "config": {
          "layout": "list",
          "leadingIconField": "icon",
          "statusField": "statusTag",
          "fallbackToFirst": true,
          "searchable": false,
          "showFooter": false,
          "rowActivation": "expand",
          "rowExpandMode": "multiple",
          "emptyText": "empty.noApps",
          "rowActions": {
            "maxVisible": 1,
            "items": [
              {
                "kind": "local",
                "id": "newChat",
                "labelKey": "action.newConversation",
                "icon": "square-pen",
                "iconOnly": true
              },
              {
                "kind": "local",
                "id": "editMeta",
                "labelKey": "action.editMeta"
              },
              {
                "kind": "operation",
                "operation": "deleteDraft",
                "labelKey": "action.delete",
                "tone": "danger",
                "when": { "field": "published", "equals": false }
              },
              {
                "kind": "operation",
                "operation": "deletePublished",
                "labelKey": "action.delete",
                "tone": "danger",
                "when": { "field": "published", "equals": true }
              }
            ]
          }
        }
      },
      "sessions": {
        "id": "builtin-product-app-builder-sessions",
        "component": "ObjectList",
        "type": "platform:Application",
        "target": { "fromSlot": true },
        "data": { "rows": "builderSessions" },
        "state": { "selected": "selectedSession" },
        "config": {
          "layout": "list",
          "statusField": "runningDot",
          "statusStyle": "dot",
          "pagination": "load-more",
          "pageSize": 10,
          "emptyText": "empty.noSessions"
        }
      },
      "project": {
        "id": "builtin-product-app-builder-project",
        "component": "ObjectSummary",
        "target": "app",
        "data": { "record": "builderProject" },
        "operations": {
          "sync": "applications.syncBuilderSource"
        },
        "config": {
          "fields": ["shortHeadCommit", "busyLabel"]
        }
      },
      "chat": {
        "id": "builtin-product-app-builder-chat",
        "component": "AgentChat",
        "agent": { "kind": "preset", "agentKind": "app-builder" },
        "state": { "sessionId": "session" },
        "config": {
          "showHeader": false,
          "placeholderKey": "chat.placeholder"
        }
      },
      "sourceFiles": {
        "id": "builtin-product-app-builder-source-files",
        "component": "ObjectTree",
        "target": "app",
        "data": { "files": "sourceFiles" },
        "state": { "selected": "file" },
        "config": {
          "fallbackToFirst": true,
          "emptyText": "empty.noFiles",
          "label": "tab.files"
        }
      },
      "sourceFile": {
        "id": "builtin-product-app-builder-source-file",
        "component": "ObjectTextReader",
        "target": "app",
        "data": {
          "record": {
            "read": "sourceFile",
            "params": { "path": { "state": "file" } }
          }
        },
        "config": {
          "textField": "content",
          "pathField": "path",
          "format": "auto",
          "emptyText": "empty.selectFile"
        }
      },
      "sourceDiff": {
        "id": "builtin-product-app-builder-source-diff",
        "component": "ObjectTextReader",
        "target": "app",
        "data": {
          "record": {
            "read": "sourceDiff",
            "params": { "target": { "state": "diffTarget" } }
          }
        },
        "config": {
          "textField": "content",
          "format": "diff",
          "emptyText": "empty.noDiff"
        }
      },
      "sourceCommits": {
        "id": "builtin-product-app-builder-source-commits",
        "component": "ObjectList",
        "target": "app",
        "data": { "rows": "sourceCommits" },
        "operations": {
          "restore": {
            "operation": "applications.restoreSourceCommit",
            "target": { "state": "app" },
            "params": { "commit": { "rowField": "id" } }
          }
        },
        "config": {
          "layout": "table",
          "pagination": "load-more",
          "pageSize": 20,
          "showFooter": false,
          "emptyText": "empty.noCommits",
          "columns": [
            { "key": "shortId", "labelKey": "col.commit", "width": "92px" },
            { "key": "message", "labelKey": "col.message" },
            { "key": "createdAt", "labelKey": "col.time", "kind": "time", "timeFormat": "relative", "width": "140px" }
          ],
          "rowActions": {
            "maxVisible": 2,
            "items": [
              { "kind": "local", "id": "viewDiff", "labelKey": "action.viewChanges" },
              {
                "kind": "local",
                "id": "publishCommit",
                "labelKey": "action.publishCommit",
                "when": { "field": "isPublishable", "equals": true }
              },
              {
                "kind": "operation",
                "operation": "restore",
                "labelKey": "action.restoreCommit",
                "when": { "field": "isHead", "equals": false }
              }
            ]
          }
        }
      },
      "createForm": {
        "id": "builtin-product-app-builder-create-form",
        "component": "ObjectForm",
        "type": "platform:Application",
        "data": { "createForm": "builderCreateForm" },
        "operation": "applications.createDraft",
        "config": { "actions": "footer" }
      },
      "metaForm": {
        "id": "builtin-product-app-builder-meta-form",
        "component": "ObjectForm",
        "target": "editTarget",
        "data": { "form": "builderMetaForm" },
        "operation": "applications.updateBuilderMeta",
        "config": { "actions": "footer" }
      },
      "publishForm": {
        "id": "builtin-product-app-builder-publish-form",
        "component": "ObjectForm",
        "target": "app",
        "data": {
          "form": {
            "read": "builderPublishForm",
            "params": { "defaultCommit": { "state": "publishCommit" } }
          }
        },
        "operation": "applications.publishBuilderSource",
        "config": { "actions": "footer" }
      },
      "releases": {
        "id": "builtin-product-app-builder-releases",
        "component": "ObjectList",
        "target": "app",
        "data": { "rows": "sourceReleases" },
        "operations": {
          "rollback": {
            "operation": "applications.rollbackBuilderRelease",
            "target": { "state": "app" },
            "params": { "releaseId": { "rowField": "releaseId" } }
          }
        },
        "config": {
          "layout": "table",
          "showFooter": false,
          "emptyText": "empty.noReleases",
          "columns": [
            { "key": "shortCommit", "labelKey": "col.commit", "width": "92px" },
            { "key": "createdAt", "labelKey": "col.publishedAt", "kind": "time", "timeFormat": "datetime" }
          ],
          "rowActions": {
            "maxVisible": 1,
            "items": [
              {
                "kind": "operation",
                "operation": "rollback",
                "labelKey": "action.rollback",
                "when": { "field": "isCurrent", "equals": false }
              }
            ]
          }
        }
      }
    }
  },
