{
  "manifest": {
    "state": {
      "workspace": {
        "type": {
          "kind": "object",
          "objectType": "platform:AppWorkspace"
        },
        "deepLink": true
      },
      "tab": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": "files"
      },
      "filePath": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      },
      "fileSearch": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      },
      "diffTarget": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": "latest"
      },
      "renaming": {
        "type": {
          "kind": "scalar",
          "type": "boolean"
        },
        "deepLink": false
      },
      "publishing": {
        "type": {
          "kind": "scalar",
          "type": "boolean"
        },
        "deepLink": false
      },
      "sessionsOpen": {
        "type": {
          "kind": "scalar",
          "type": "boolean"
        },
        "deepLink": false
      }
    },
    "members": {
      "detailHeader": {
        "component": "ObjectHeader",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "data": {
          "record": "record"
        },
        "config": {
          "subtitleField": "shortHeadCommit",
          "statusField": "busyLabel"
        },
        "name": "Workspace header",
        "description": "Displays the workspace title, current commit, run status badge, and read-only record outputs.",
        "id": "builtin-product-680fc965-8e9e-4027-b912-8a1f4f056b0b"
      },
      "conversationEntry": {
        "component": "ConversationEntry",
        "agent": "page-default",
        "prefillKey": "panel.buildPrefill",
        "config": {
          "type": "primary",
          "labelKey": "action.chat"
        },
        "name": "Chat with builder agent",
        "description": "Expand the page composer to collaborate with the App Builder agent on this workspace.",
        "id": "builtin-product-d191e385-d61b-4a44-b971-746dc8b74442"
      },
      "workspaceSummary": {
        "component": "ObjectSummary",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "data": {
          "record": "record"
        },
        "config": {
          "showTitle": false,
          "fields": [
            "shortHeadCommit",
            "busyLabel",
            "buildTestStatusLabel",
            "buildTestSampleName",
            "publishedAppName",
            "updatedAt"
          ]
        },
        "name": "Workspace status summary",
        "description": "Displays current commit, workspace status, business test data status, published application, and update time.",
        "id": "builtin-product-895dc722-748f-4431-8169-0847c47eb35f"
      },
      "restartBuildTest": {
        "component": "OperationButton",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "operation": "appWorkspaces.restartBuildTest",
        "config": {
          "type": "default",
          "size": "small",
          "hideWhenUnavailable": true
        },
        "name": "Restart business test",
        "description": "Restart an ended or expired business test sample for this workspace.",
        "id": "builtin-product-4f49e14d-0d25-4298-b983-0784f536b81b"
      },
      "fileTree": {
        "component": "ObjectTree",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "data": {
          "files": "files"
        },
        "state": {
          "selected": "filePath",
          "search": "fileSearch"
        },
        "config": {
          "fallbackToFirst": true,
          "searchable": true,
          "searchPlaceholder": "files.searchPlaceholder",
          "label": "files.treeTitle",
          "emptyText": "files.empty",
          "noMatchText": "files.noMatch"
        },
        "name": "Workspace files",
        "description": "Searchable directory tree of files in the workspace.",
        "id": "builtin-product-d47db9de-985c-4d50-a81b-e3e53f17ac3a"
      },
      "fileNonTextNotice": {
        "component": "InfoBanner",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "data": {
          "record": {
            "read": "file",
            "params": {
              "path": {
                "state": "filePath"
              }
            }
          }
        },
        "config": {
          "field": "nonTextNotice",
          "tone": "info",
          "compact": true,
          "hideWhenEmpty": true
        },
        "name": "Non-text file notice",
        "description": "Displays an informational notice when the selected workspace file is not a text file.",
        "id": "builtin-product-cc342087-4db1-4a77-abf0-f1546f0fcae5"
      },
      "fileViewer": {
        "component": "ObjectTextReader",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "data": {
          "record": {
            "read": "file",
            "params": {
              "path": {
                "state": "filePath"
              }
            }
          }
        },
        "state": {
          "activePath": "filePath"
        },
        "config": {
          "format": "auto",
          "textField": "content",
          "pathField": "path",
          "emptyText": "files.selectHint"
        },
        "name": "Workspace file viewer",
        "description": "Read-only viewer for the selected workspace file.",
        "id": "builtin-product-c8954744-c267-4e14-a065-d3f7844b9ec3"
      },
      "diffSummary": {
        "component": "ObjectSummary",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "data": {
          "record": {
            "read": "diff",
            "params": {
              "target": {
                "state": "diffTarget"
              }
            }
          }
        },
        "config": {
          "showTitle": false,
          "fields": [
            "targetLabel",
            "comparisonLabel"
          ]
        },
        "name": "Diff comparison summary",
        "description": "Shows the diff target and baseline commit being compared.",
        "id": "builtin-product-72dc4644-dc30-4618-92ec-e1e2afccb7f4"
      },
      "diffViewer": {
        "component": "ObjectTextReader",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "data": {
          "record": {
            "read": "diff",
            "params": {
              "target": {
                "state": "diffTarget"
              }
            }
          }
        },
        "config": {
          "format": "diff",
          "textField": "content",
          "emptyText": "changes.empty"
        },
        "name": "Workspace diff viewer",
        "description": "Unified patch diff viewer for uncommitted changes or any workspace commit.",
        "id": "builtin-product-dbf4ad21-364d-47f0-a7dd-6dd030c76c54"
      },
      "commitsList": {
        "component": "ObjectList",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "data": {
          "rows": "commits"
        },
        "operations": {
          "restoreCommit": {
            "operation": "appWorkspaces.restoreCommit",
            "target": {
              "state": "workspace"
            },
            "params": {
              "commit": {
                "row": "primaryKey"
              }
            }
          }
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "fallbackToFirst": false,
          "emptyText": "history.empty",
          "columns": [
            {
              "key": "message",
              "labelKey": "history.colMessage",
              "minWidth": 220,
              "wrap": true
            },
            {
              "key": "shortId",
              "labelKey": "history.colCommit",
              "width": 110
            },
            {
              "key": "isHead",
              "labelKey": "history.colStatus",
              "kind": "tag",
              "width": 110,
              "valueMap": {
                "true": {
                  "labelKey": "history.current",
                  "tone": "success"
                },
                "false": {
                  "labelKey": "history.historical",
                  "tone": "default"
                }
              }
            },
            {
              "key": "createdAt",
              "labelKey": "history.colCreatedAt",
              "kind": "time",
              "width": 160
            }
          ],
          "rowActions": {
            "labelKey": "table.actions",
            "maxVisible": 2,
            "items": [
              {
                "kind": "local",
                "id": "diff",
                "labelKey": "history.viewChanges"
              },
              {
                "kind": "operation",
                "operation": "restoreCommit",
                "labelKey": "history.restore"
              }
            ]
          }
        },
        "name": "Commit history",
        "description": "Lists workspace commits with diff inspection and version restore actions.",
        "id": "builtin-product-790cff52-d843-4043-a0fd-5e5effe9069d"
      },
      "releasesList": {
        "component": "ObjectList",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "data": {
          "rows": "releases"
        },
        "operations": {
          "rollbackRelease": {
            "operation": "appWorkspaces.rollbackRelease",
            "target": {
              "state": "workspace"
            },
            "params": {
              "releaseId": {
                "row": "primaryKey"
              }
            }
          }
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "showFooter": false,
          "fallbackToFirst": false,
          "emptyText": "releases.empty",
          "columns": [
            {
              "key": "commitMessage",
              "labelKey": "releases.colMessage",
              "minWidth": 220,
              "wrap": true
            },
            {
              "key": "shortCommit",
              "labelKey": "releases.colCommit",
              "width": 110
            },
            {
              "key": "isCurrent",
              "labelKey": "releases.colStatus",
              "kind": "tag",
              "width": 110,
              "valueMap": {
                "true": {
                  "labelKey": "releases.current",
                  "tone": "success"
                },
                "false": {
                  "labelKey": "releases.previous",
                  "tone": "default"
                }
              }
            },
            {
              "key": "createdAt",
              "labelKey": "releases.colCreatedAt",
              "kind": "time",
              "width": 160
            }
          ],
          "rowActions": {
            "labelKey": "table.actions",
            "maxVisible": 1,
            "items": [
              {
                "kind": "operation",
                "operation": "rollbackRelease",
                "labelKey": "releases.rollback"
              }
            ]
          }
        },
        "name": "Release history",
        "description": "Lists published releases of this workspace with rollback actions.",
        "id": "builtin-product-16cd1659-f34b-4224-a713-5edcd6ca8520"
      },
      "renameForm": {
        "component": "ObjectForm",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "data": {
          "form": "form"
        },
        "operation": "appWorkspaces.save",
        "config": {
          "actions": "footer"
        },
        "name": "Rename workspace form",
        "description": "Form to rename the current workspace.",
        "id": "builtin-product-69142e8c-851b-4e74-b5b0-1d9d2e6b161a"
      },
      "publishForm": {
        "component": "ObjectForm",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "data": {
          "form": "publishForm"
        },
        "operation": "appWorkspaces.publish",
        "config": {
          "actions": "footer"
        },
        "name": "Publish application form",
        "description": "Form to publish a workspace commit as an application release.",
        "id": "builtin-product-89c67da0-b312-437c-b3a7-76c24c5beb12"
      },
      "sessionsList": {
        "component": "ObjectList",
        "type": "platform:AppWorkspace",
        "target": "workspace",
        "data": {
          "rows": "sessions"
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "showFooter": false,
          "fallbackToFirst": false,
          "openOutput": "openPath",
          "showChevron": true,
          "emptyText": "sessions.empty",
          "columns": [
            {
              "key": "title",
              "labelKey": "sessions.colTitle",
              "minWidth": 200
            },
            {
              "key": "statusLabel",
              "labelKey": "sessions.colStatus",
              "kind": "tag",
              "width": 120
            },
            {
              "key": "updatedAt",
              "labelKey": "sessions.colUpdatedAt",
              "kind": "time",
              "width": 160
            }
          ]
        },
        "name": "Linked conversations",
        "description": "Lists AgentSession conversations linked to this workspace; click a row to open it in the Agent platform.",
        "id": "builtin-product-ed8ce108-4f34-42e4-a08b-e2d297f672be"
      }
    }
  },
