{
  "manifest": {
    "state": {
      "app": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      },
      "selectedTask": {
        "type": {
          "kind": "object",
          "objectType": "platform:ScheduledTask"
        },
        "deepLink": true
      },
      "runId": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      },
      "compose": {
        "type": {
          "kind": "scalar",
          "type": "string"
        }
      },
      "newTask": {
        "type": {
          "kind": "object",
          "objectType": "platform:ScheduledTask"
        }
      },
      "schedulesApplication": {
        "type": {
          "kind": "object",
          "objectType": "platform:Application"
        },
        "deepLink": true,
        "external": true
      },
      "search": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": false,
        "default": ""
      }
    },
    "members": {
      "pageNotice": {
        "component": "InfoBanner",
        "type": "platform:ScheduledTask",
        "data": {
          "record": "status"
        },
        "config": {
          "tone": "warning",
          "field": "applicationsProblem",
          "hideWhenEmpty": true
        },
        "id": "builtin-product-9f2c8b14-6d71-4e3a-8c52-1a4b9e6d0f31"
      },
      "appFilter": {
        "component": "SegmentedControl",
        "type": "platform:ScheduledTask",
        "data": {
          "counts": {
            "read": "counts",
            "params": {
              "by": {
                "literal": "application"
              }
            }
          }
        },
        "state": {
          "value": "app"
        },
        "config": {
          "ariaLabelKey": "filter.label",
          "defaultValue": ""
        },
        "id": "builtin-product-206cd648-2af3-4d9c-a69c-153ecb4952e3"
      },
      "tasks": {
        "component": "ObjectList",
        "type": "platform:ScheduledTask",
        "data": {
          "rows": "list"
        },
        "state": {
          "selected": "selectedTask",
          "search": "search"
        },
        "inputs": {
          "application": {
            "state": "app"
          }
        },
        "operations": {
          "enable": {
            "operation": "platform:ScheduledTask.setEnabled",
            "target": "row",
            "params": {
              "enabled": {
                "literal": true
              },
              "revision": {
                "rowField": "revision"
              }
            }
          },
          "disable": {
            "operation": "platform:ScheduledTask.setEnabled",
            "target": "row",
            "params": {
              "enabled": {
                "literal": false
              },
              "revision": {
                "rowField": "revision"
              }
            }
          },
          "runNow": {
            "operation": "schedules.runNow",
            "target": "row"
          },
          "delete": {
            "operation": "platform:ScheduledTask.delete",
            "target": "row",
            "params": {
              "revision": {
                "rowField": "revision"
              }
            }
          }
        },
        "config": {
          "layout": "cards",
          "skeletonCount": 3,
          "subtitleField": "settings",
          "subtitleLines": 2,
          "statusField": "stateLabel",
          "searchPlaceholder": "filter.search",
          "searchFields": [
            "label"
          ],
          "emptyText": "empty.none",
          "noMatchText": "empty.noMatch",
          "columns": [
            {
              "key": "applicationName"
            },
            {
              "key": "frequency"
            },
            {
              "key": "nextRun",
              "kind": "time"
            },
            {
              "key": "lastRun",
              "kind": "tag",
              "valueMap": {
                "running": {
                  "labelKey": "runStatus.running",
                  "tone": "info"
                },
                "completed": {
                  "labelKey": "runStatus.completed",
                  "tone": "success"
                },
                "failed": {
                  "labelKey": "runStatus.failed",
                  "tone": "danger"
                },
                "skipped": {
                  "labelKey": "runStatus.skipped",
                  "tone": "warning"
                }
              }
            },
            {
              "key": "lastRunAt",
              "kind": "time"
            },
            {
              "key": "lastRunSummary"
            },
            {
              "key": "resultStateLabel"
            },
            {
              "key": "pauseReason"
            }
          ],
          "rowActions": {
            "maxVisible": 3,
            "items": [
              {
                "kind": "local",
                "id": "review",
                "labelKey": "card.review",
                "tone": "primary",
                "when": {
                  "field": "pauseCode",
                  "equals": "definition_changed"
                }
              },
              {
                "kind": "local",
                "id": "viewResult",
                "labelKey": "card.viewResult",
                "tone": "primary",
                "when": {
                  "field": "resultActionState",
                  "equals": "latest"
                }
              },
              {
                "kind": "local",
                "id": "viewEarlierResult",
                "labelKey": "card.viewEarlierResult",
                "tone": "primary",
                "when": {
                  "field": "resultActionState",
                  "equals": "earlier"
                }
              },
              {
                "kind": "local",
                "id": "recordsQuick",
                "labelKey": "action.records",
                "tone": "primary",
                "when": {
                  "field": "lastRun",
                  "in": [
                    "failed",
                    "skipped"
                  ]
                }
              },
              {
                "kind": "operation",
                "operation": "enable",
                "labelKey": "action.enable",
                "when": {
                  "field": "enabled",
                  "equals": false
                }
              },
              {
                "kind": "operation",
                "operation": "disable",
                "labelKey": "action.disable",
                "when": {
                  "field": "enabled",
                  "equals": true
                }
              },
              {
                "kind": "operation",
                "operation": "runNow",
                "labelKey": "action.runNow"
              },
              {
                "kind": "local",
                "id": "edit",
                "labelKey": "action.edit"
              },
              {
                "kind": "local",
                "id": "records",
                "labelKey": "action.records",
                "when": {
                  "field": "lastRun",
                  "notIn": [
                    "failed",
                    "skipped"
                  ]
                }
              },
              {
                "kind": "operation",
                "operation": "delete",
                "labelKey": "action.delete",
                "tone": "danger"
              }
            ]
          }
        },
        "id": "builtin-product-a60f79e0-fde0-4317-aa18-140d429b74e6"
      },
      "detailHeader": {
        "component": "ObjectHeader",
        "type": "platform:ScheduledTask",
        "target": "selectedTask",
        "data": {
          "record": "record"
        },
        "config": {
          "subtitleField": "applicationName",
          "statusField": "stateLabel"
        },
        "id": "builtin-product-80bea445-8596-42d6-b866-bc4956e8ffad"
      },
      "detailPause": {
        "component": "InfoBanner",
        "type": "platform:ScheduledTask",
        "target": "selectedTask",
        "data": {
          "record": "record"
        },
        "config": {
          "tone": "warning",
          "titleKey": "state.paused",
          "field": "pauseReason",
          "hideWhenEmpty": true,
          "compact": true
        },
        "id": "builtin-product-a25fbb0c-4ca9-4288-a6e6-db95c4ee8b21"
      },
      "detailSummary": {
        "component": "ObjectSummary",
        "type": "platform:ScheduledTask",
        "target": "selectedTask",
        "data": {
          "record": "record"
        },
        "config": {
          "showTitle": false,
          "fields": [
            "settings",
            "frequency",
            "timeZone",
            "nextRun",
            "lastRun",
            "lastRunAt",
            "lastRunSummary",
            "resultStateLabel",
            "notifyEmail"
          ]
        },
        "id": "builtin-product-3e9c84d2-71b5-4c8a-9f14-6b2e5a8d10c3"
      },
      "history": {
        "component": "ObjectList",
        "type": "platform:ScheduledTask",
        "target": "selectedTask",
        "data": {
          "rows": "runRecords"
        },
        "config": {
          "layout": "cards",
          "pagination": "load-more",
          "statusField": "status",
          "subtitleField": "resultSummary",
          "subtitleLines": 2,
          "emptyText": "runs.empty",
          "columns": [
            {
              "key": "trigger"
            },
            {
              "key": "startedAt",
              "kind": "time"
            },
            {
              "key": "scheduledAt",
              "kind": "time"
            },
            {
              "key": "duration"
            },
            {
              "key": "error"
            },
            {
              "key": "resultPath"
            }
          ],
          "rowActions": {
            "maxVisible": 1,
            "items": [
              {
                "kind": "local",
                "id": "details",
                "labelKey": "runs.details"
              }
            ]
          }
        },
        "id": "builtin-product-514d483b-ac7e-4345-9cd5-1125425e80fb"
      },
      "focus": {
        "component": "ObjectSummary",
        "type": "platform:ScheduledTask",
        "target": "selectedTask",
        "data": {
          "record": {
            "read": "runRecord",
            "params": {
              "runId": {
                "state": "runId"
              }
            }
          }
        },
        "config": {
          "showTitle": true,
          "fields": [
            "status",
            "trigger",
            "startedAt",
            "scheduledAt",
            "duration",
            "error",
            "resultSummary",
            "snapshotSummary",
            "result",
            "executionDetails"
          ]
        },
        "id": "builtin-product-003dc4a7-ce06-4b82-93f7-edb8e907d574"
      },
      "editForm": {
        "component": "ObjectForm",
        "type": "platform:ScheduledTask",
        "target": "selectedTask",
        "data": {
          "form": "form",
          "createForm": "createForm"
        },
        "operation": "platform:ScheduledTask.save",
        "config": {
          "showToc": false
        },
        "id": "builtin-product-1a694994-8d2f-4ae7-8367-08c64b7cffed"
      },
      "newForm": {
        "component": "ObjectForm",
        "type": "platform:ScheduledTask",
        "target": "newTask",
        "data": {
          "form": "form",
          "createForm": {
            "read": "createForm",
            "params": {
              "defaultAppId": {
                "state": "app"
              }
            }
          }
        },
        "operation": "platform:ScheduledTask.create",
        "config": {
          "showToc": false
        },
        "id": "builtin-product-81d6942e-922d-4964-a998-b48dbd0ec7c3"
      },
      "opEnable": {
        "component": "OperationButton",
        "type": "platform:ScheduledTask",
        "target": "selectedTask",
        "operation": "platform:ScheduledTask.setEnabled",
        "id": "builtin-product-cc431561-faab-4244-ab89-d4e1465ce208"
      },
      "opRunNow": {
        "component": "OperationButton",
        "type": "platform:ScheduledTask",
        "target": "selectedTask",
        "operation": "schedules.runNow",
        "id": "builtin-product-8e1a6e5f-988e-42ac-8acb-aacefceea339"
      },
      "opDelete": {
        "component": "OperationButton",
        "type": "platform:ScheduledTask",
        "target": "selectedTask",
        "operation": "platform:ScheduledTask.delete",
        "config": {
          "type": "danger"
        },
        "id": "builtin-product-9bcce198-a37c-45b8-8fe4-08084beaeeb6"
      },
      "renew": {
        "component": "PanelData",
        "type": "platform:Application",
        "target": "schedulesApplication",
        "operation": "schedules.renewCredential",
        "id": "builtin-product-c533fb06-5286-495f-95f1-304b5752a802"
      }
    }
  },
