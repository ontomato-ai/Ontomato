{
  "manifest": {
    "state": {
      "app": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      },
      "status": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      },
      "selectedTask": {
        "type": {
          "kind": "object",
          "objectType": "platform:Trigger"
        },
        "deepLink": true
      },
      "runId": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      },
      "compose": {
        "type": {
          "kind": "scalar",
          "type": "string"
        }
      },
      "workspaceCompose": {
        "type": { "kind": "scalar", "type": "string" },
        "deepLink": true
      },
      "workspace": {
        "type": { "kind": "scalar", "type": "string" },
        "deepLink": true
      },
      "workspaceAgent": {
        "type": { "kind": "scalar", "type": "string" },
        "deepLink": true
      },
      "newTask": {
        "type": {
          "kind": "object",
          "objectType": "platform:Trigger"
        }
      },
      "schedulesApplication": {
        "type": {
          "kind": "object",
          "objectType": "platform:Application"
        },
        "deepLink": true,
        "external": true
      },
      "search": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "default": ""
      },
      "focusResultPath": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "default": ""
      },
      "focusRunning": {
        "type": {
          "kind": "scalar",
          "type": "boolean"
        },
        "default": false
      },
      "focusLoadStatus": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "default": ""
      }
    },
    "members": {
      "pageNotice": {
        "component": "InfoBanner",
        "type": "platform:Trigger",
        "data": {
          "record": "status"
        },
        "config": {
          "tone": "warning",
          "field": "applicationsProblem",
          "hideWhenEmpty": true
        },
        "id": "builtin-product-9f2c8b14-6d71-4e3a-8c52-1a4b9e6d0f31"
      },
      "appFilter": {
        "component": "SegmentedControl",
        "type": "platform:Trigger",
        "data": {
          "counts": {
            "read": "counts",
            "params": {
              "by": {
                "literal": "targetKind"
              }
            }
          }
        },
        "state": {
          "value": "app"
        },
        "config": {
          "ariaLabelKey": "filter.label",
          "defaultValue": "",
          "maxVisible": 6
        },
        "id": "builtin-product-206cd648-2af3-4d9c-a69c-153ecb4952e3"
      },
      "tasks": {
        "component": "ScheduledTaskSummaryList",
        "type": "platform:Trigger",
        "data": {
          "rows": {
            "read": "catalogue",
            "params": {
              "scope": {
                "state": "app"
              },
              "search": {
                "state": "search"
              },
              "status": {
                "state": "status"
              },
              "workspace": { "state": "workspace" },
              "workspaceAgent": { "state": "workspaceAgent" },
              "selectedTask": { "state": "selectedTask" }
            }
          }
        },
        "state": {
          "selected": "selectedTask"
        },
        "operations": {
          "setEnabled": {
            "operation": "triggers.setEnabled",
            "target": "row"
          },
          "publish": {
            "operation": "triggers.setStatus",
            "target": "row",
            "params": {
              "status": {
                "literal": "PUBLISHED"
              },
              "enabled": {
                "literal": true
              },
              "revision": {
                "rowField": "revision"
              }
            }
          },
          "unuse": {
            "operation": "triggers.setStatus",
            "target": "row",
            "params": {
              "status": {
                "literal": "UNUSED"
              },
              "enabled": {
                "literal": false
              },
              "revision": {
                "rowField": "revision"
              }
            }
          },
          "runNow": {
            "operation": "triggers.runNow",
            "target": "row"
          },
          "delete": {
            "operation": "triggers.delete",
            "target": "row",
            "params": {
              "revision": {
                "rowField": "revision"
              }
            }
          }
        },
        "config": {
          "presentation": "cards",
          "rowActions": {
            "maxVisible": 2,
            "items": [
              {
                "kind": "local",
                "id": "review",
                "labelKey": "card.review",
                "tone": "primary",
                "when": {
                  "field": "pauseCode",
                  "equals": "definition_changed"
                }
              },
              {
                "kind": "operation",
                "operation": "publish",
                "labelKey": "action.publish",
                "tone": "primary",
                "when": {
                  "field": "status",
                  "notEquals": "PUBLISHED"
                }
              },
              {
                "kind": "local",
                "id": "viewResult",
                "labelKey": "card.viewResult",
                "tone": "primary",
                "when": {
                  "field": "resultActionState",
                  "equals": "latest"
                }
              },
              {
                "kind": "local",
                "id": "viewEarlierResult",
                "labelKey": "card.viewEarlierResult",
                "tone": "primary",
                "when": {
                  "field": "resultActionState",
                  "equals": "earlier"
                }
              },
              {
                "kind": "local",
                "id": "recordsQuick",
                "labelKey": "action.records",
                "tone": "primary",
                "when": {
                  "field": "lastRun",
                  "in": [
                    "failed",
                    "skipped"
                  ]
                }
              },
              {
                "kind": "operation",
                "operation": "runNow",
                "labelKey": "action.runNow"
              },
              {
                "kind": "local",
                "id": "edit",
                "labelKey": "action.edit"
              },
              {
                "kind": "operation",
                "operation": "unuse",
                "labelKey": "action.unuse",
                "when": {
                  "field": "status",
                  "equals": "PUBLISHED"
                }
              },
              {
                "kind": "local",
                "id": "records",
                "labelKey": "action.records",
                "when": {
                  "field": "lastRun",
                  "notIn": [
                    "failed",
                    "skipped"
                  ]
                }
              },
              {
                "kind": "operation",
                "operation": "delete",
                "labelKey": "action.delete",
                "tone": "danger"
              }
            ]
          }
        },
        "id": "builtin-product-a60f79e0-fde0-4317-aa18-140d429b74e6"
      },
      "detailHeader": {
        "component": "ObjectHeader",
        "target": "selectedTask",
        "data": {
          "record": "record"
        },
        "config": {
          "subtitleField": "targetName",
          "statusField": "stateLabel"
        },
        "id": "builtin-product-80bea445-8596-42d6-b866-bc4956e8ffad"
      },
      "detailPause": {
        "component": "InfoBanner",
        "target": "selectedTask",
        "data": {
          "record": "record"
        },
        "config": {
          "tone": "warning",
          "titleKey": "state.paused",
          "field": "pauseReason",
          "hideWhenEmpty": true,
          "compact": true
        },
        "id": "builtin-product-a25fbb0c-4ca9-4288-a6e6-db95c4ee8b21"
      },
      "detailSummary": {
        "component": "ObjectSummary",
        "target": "selectedTask",
        "data": {
          "record": "record"
        },
        "config": {
          "showTitle": false,
          "fields": [
            "targetName",
            "definitionStatus",
            "version",
            "reviewedBy",
            "executorId",
            "coauthorIds",
            "settings",
            "frequency",
            "timeZone",
            "nextRun",
            "lastRun",
            "lastRunAt",
            "lastRunSummary",
            "resultStateLabel",
            "notifyEmail"
          ]
        },
        "id": "builtin-product-3e9c84d2-71b5-4c8a-9f14-6b2e5a8d10c3"
      },
      "history": {
        "component": "ObjectList",
        "target": "selectedTask",
        "data": {
          "rows": "runRecords"
        },
        "config": {
          "layout": "cards",
          "pagination": "load-more",
          "rowExpandMode": "multiple",
          "statusField": "status",
          "subtitleField": "resultSummary",
          "subtitleLines": 2,
          "emptyText": "runs.empty",
          "columns": [
            {
              "key": "trigger"
            },
            {
              "key": "startedAt",
              "kind": "time"
            },
            {
              "key": "scheduledAt",
              "kind": "time"
            },
            {
              "key": "duration"
            },
            {
              "key": "executorId"
            },
            {
              "key": "version"
            },
            {
              "key": "workflowRunId"
            },
            {
              "key": "error"
            },
            {
              "key": "resultPath"
            }
          ],
          "rowActions": {
            "maxVisible": 1,
            "items": [
              {
                "kind": "local",
                "id": "details",
                "labelKey": "runs.details"
              }
            ]
          }
        },
        "id": "builtin-product-514d483b-ac7e-4345-9cd5-1125425e80fb"
      },
      "runDetail": {
        "component": "ObjectSummary",
        "target": "selectedTask",
        "data": {
          "record": {
            "read": "runRecord",
            "params": {
              "runId": {
                "fromSlot": true
              }
            }
          }
        },
        "config": {
          "showTitle": false,
          "fields": [
            "executorId",
            "version",
            "workflowRunId",
            "snapshotSummary",
            "result",
            "executionDetails"
          ]
        },
        "id": "builtin-product-6c8e4b19-2d7a-4f31-9e50-8b2d6a4c1e97"
      },
      "focus": {
        "target": {
          "panelId": "builtin-product-scheduled-task-run-detail"
        },
        "inputs": {
          "task": {
            "state": "selectedTask"
          },
          "runId": {
            "state": "runId"
          }
        },
        "outputs": {
          "resultPath": {
            "state": "focusResultPath"
          },
          "isRunning": {
            "state": "focusRunning"
          },
          "loadStatus": {
            "state": "focusLoadStatus"
          }
        }
      },
      "editForm": {
        "component": "ObjectForm",
        "target": "selectedTask",
        "data": {
          "form": "form",
          "createForm": "createForm"
        },
        "operation": "platform:Trigger.save",
        "config": {
          "showToc": false
        },
        "id": "builtin-product-1a694994-8d2f-4ae7-8367-08c64b7cffed"
      },
      "newForm": {
        "component": "ObjectForm",
        "target": "newTask",
        "data": {
          "form": "form",
          "createForm": {
            "read": "createForm",
            "params": {
              "defaultAppId": {
                "state": "app"
              },
              "defaultAgentId": { "state": "workspaceAgent" }
            }
          }
        },
        "operation": "triggers.create",
        "config": {
          "showToc": false
        },
        "id": "builtin-product-81d6942e-922d-4964-a998-b48dbd0ec7c3"
      },
      "executorPicker": {
        "component": "ReferencePicker",
        "type": "platform:Trigger",
        "data": {
          "options": "memberOptions",
          "selected": "memberResolve"
        },
        "config": {
          "refreshable": true
        },
        "id": "builtin-product-d3e5f8a2-7b14-4c92-8e61-4a7b9c2d5e30"
      },
      "coauthorsPicker": {
        "component": "ReferencePicker",
        "type": "platform:Trigger",
        "data": {
          "options": "memberOptions",
          "selected": "memberResolve"
        },
        "config": {
          "refreshable": true
        },
        "id": "builtin-product-e4f6a9b3-8c25-4d03-9f72-5b8c0d3e6f41"
      },
      "opEnable": {
        "component": "OperationButton",
        "target": "selectedTask",
        "operation": "triggers.setEnabled",
        "id": "builtin-product-cc431561-faab-4244-ab89-d4e1465ce208"
      },
      "opSetStatus": {
        "component": "OperationButton",
        "target": "selectedTask",
        "operation": "triggers.setStatus",
        "id": "builtin-product-7a4b9c2d-3e5f-4a18-9b6c-2d8e0f4a1b3c"
      },
      "opRunNow": {
        "component": "OperationButton",
        "target": "selectedTask",
        "operation": "triggers.runNow",
        "id": "builtin-product-8e1a6e5f-988e-42ac-8acb-aacefceea339"
      },
      "opDelete": {
        "component": "OperationButton",
        "target": "selectedTask",
        "operation": "triggers.delete",
        "config": {
          "type": "danger"
        },
        "id": "builtin-product-9bcce198-a37c-45b8-8fe4-08084beaeeb6"
      },
      "renew": {
        "component": "PanelData",
        "target": "schedulesApplication",
        "operation": "triggers.renewCredential",
        "id": "builtin-product-c533fb06-5286-495f-95f1-304b5752a802"
      }
    }
  },
