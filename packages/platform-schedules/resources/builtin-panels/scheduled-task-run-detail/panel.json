{
  "manifest": {
    "state": {
      "task": {
        "type": {
          "kind": "object",
          "objectType": "platform:ScheduledTask"
        },
        "external": true
      },
      "runId": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "external": true
      },
      "resultPath": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "external": true
      },
      "isRunning": {
        "type": {
          "kind": "scalar",
          "type": "boolean"
        },
        "external": true
      },
      "loadStatus": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "external": true
      }
    },
    "members": {
      "header": {
        "component": "ObjectHeader",
        "target": "task",
        "data": {
          "record": {
            "read": "latestRunRecord",
            "params": {
              "runId": {
                "state": "runId"
              }
            }
          }
        },
        "config": {
          "subtitleField": "trigger",
          "statusField": "status"
        },
        "name": "Run status header",
        "description": "Displays the task title, trigger kind, and execution status badge.",
        "id": "builtin-product-7e2b9104-4c53-4a8e-9f11-000000000001"
      },
      "pauseNotice": {
        "component": "InfoBanner",
        "target": "task",
        "data": {
          "record": {
            "read": "latestRunRecord",
            "params": {
              "runId": {
                "state": "runId"
              }
            }
          }
        },
        "config": {
          "tone": "warning",
          "titleKey": "pauseTitle",
          "field": "pauseMessage",
          "hideWhenEmpty": true,
          "compact": true
        },
        "name": "Task pause notice",
        "description": "Shows the task pause reason when the scheduled task is paused.",
        "id": "builtin-product-7e2b9104-4c53-4a8e-9f11-000000000002"
      },
      "errorNotice": {
        "component": "InfoBanner",
        "target": "task",
        "data": {
          "record": {
            "read": "latestRunRecord",
            "params": {
              "runId": {
                "state": "runId"
              }
            }
          }
        },
        "config": {
          "tone": "danger",
          "toneField": "error",
          "titleKey": "errorTitle",
          "field": "error",
          "hideWhenEmpty": true,
          "compact": true
        },
        "name": "Run failure notice",
        "description": "Shows the failure or skip reason when the run did not succeed.",
        "id": "builtin-product-7e2b9104-4c53-4a8e-9f11-000000000003"
      },
      "startedAt": {
        "component": "TypedValue",
        "target": "task",
        "data": {
          "record": {
            "read": "latestRunRecord",
            "params": {
              "runId": {
                "state": "runId"
              }
            }
          }
        },
        "config": {
          "field": "startedAt",
          "kind": "time",
          "emptyText": "—"
        },
        "name": "Run start timestamp",
        "description": "Displays the localized start time of the task run.",
        "id": "builtin-product-7e2b9104-4c53-4a8e-9f11-000000000004"
      },
      "finishedAt": {
        "component": "TypedValue",
        "target": "task",
        "data": {
          "record": {
            "read": "latestRunRecord",
            "params": {
              "runId": {
                "state": "runId"
              }
            }
          }
        },
        "config": {
          "field": "finishedAt",
          "kind": "time",
          "emptyText": "—"
        },
        "name": "Run finish timestamp",
        "description": "Displays the localized finish time of the task run.",
        "id": "builtin-product-7e2b9104-4c53-4a8e-9f11-000000000005"
      },
      "summary": {
        "component": "ObjectSummary",
        "target": "task",
        "data": {
          "record": {
            "read": "latestRunRecord",
            "params": {
              "runId": {
                "state": "runId"
              }
            }
          }
        },
        "config": {
          "showTitle": false,
          "fields": [
            "duration",
            "timeZone",
            "snapshotSummary",
            "result",
            "executionDetails"
          ],
          "emptyText": "noResult"
        },
        "name": "Run output summary",
        "description": "Displays the run snapshot summary, cleaned execution output, and execution details.",
        "id": "builtin-product-7e2b9104-4c53-4a8e-9f11-000000000006"
      }
    }
  },
