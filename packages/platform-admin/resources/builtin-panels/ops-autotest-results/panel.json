{
  "manifest": {
    "state": {
      "selected": {
        "type": {
          "kind": "object",
          "objectType": "platform:AutotestRun"
        },
        "deepLink": true
      },
      "search": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": ""
      },
      "verdict": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": "all"
      },
      "caseDetailPath": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": false,
        "external": true,
        "default": "/ops/autotest/case"
      }
    },
    "members": {
      "runs": {
        "component": "ObjectList",
        "type": "platform:AutotestRun",
        "data": {
          "rows": "list"
        },
        "state": {
          "selected": "selected",
          "search": "search"
        },
        "operations": {
          "keep": {
            "operation": "autotestRun.keep",
            "target": "row"
          },
          "unkeep": {
            "operation": "autotestRun.unkeep",
            "target": "row"
          },
          "delete": {
            "operation": "autotestRun.delete",
            "target": "row"
          }
        },
        "config": {
          "layout": "list",
          "statusField": "statusLabel",
          "subtitleField": "summaryLine",
          "subtitleLines": 1,
          "fallbackToFirst": true,
          "searchable": true,
          "searchPlaceholder": "runs.searchPlaceholder",
          "searchFields": [
            "label",
            "caseSetName",
            "runId",
            "statusLabel",
            "keptLabel",
            "summaryLine"
          ],
          "emptyText": "runs.empty",
          "emptyHint": "runs.emptyHint",
          "noMatchText": "runs.noMatch",
          "showFooter": false,
          "rowActions": {
            "maxVisible": 2,
            "items": [
              {
                "kind": "operation",
                "operation": "keep",
                "labelKey": "runs.keep",
                "icon": "star",
                "iconOnly": true,
                "when": {
                  "field": "kept",
                  "equals": false
                }
              },
              {
                "kind": "operation",
                "operation": "unkeep",
                "labelKey": "runs.unkeep",
                "icon": "star-filled",
                "iconOnly": true,
                "active": true,
                "when": {
                  "field": "kept",
                  "equals": true
                }
              },
              {
                "kind": "operation",
                "operation": "delete",
                "labelKey": "runs.delete",
                "icon": "x",
                "iconOnly": true,
                "tone": "danger",
                "disabledWhen": {
                  "field": "active",
                  "equals": true
                }
              }
            ]
          }
        },
        "name": "Test runs",
        "description": "Compact list of automatic test runs with inline keep/unkeep and delete row actions",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1001"
      },
      "runStatus": {
        "component": "TypedValue",
        "type": "platform:AutotestRun",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "field": "statusLabel",
          "kind": "tag",
          "emptyText": ""
        },
        "name": "Test run status",
        "description": "Displays the selected test run status badge and exposes read-only lifecycle outputs",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1002"
      },
      "runSummary": {
        "component": "RecordTemplate",
        "type": "platform:AutotestRun",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "templateKey": "detail.summaryTemplate",
          "inline": true,
          "emptyKey": "common.dash"
        },
        "name": "Test run summary",
        "description": "Single-line summary of total, correct, wrong, abnormal counts, accuracy rate, and average duration",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1006"
      },
      "keepRun": {
        "component": "OperationButton",
        "type": "platform:AutotestRun",
        "target": "selected",
        "operation": "autotestRun.keep",
        "config": {
          "type": "default",
          "size": "small",
          "hideWhenUnavailable": true
        },
        "name": "Keep test run",
        "description": "Mark the selected test run as kept to protect its artifacts from automatic cleanup",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1007"
      },
      "unkeepRun": {
        "component": "OperationButton",
        "type": "platform:AutotestRun",
        "target": "selected",
        "operation": "autotestRun.unkeep",
        "config": {
          "type": "default",
          "size": "small",
          "hideWhenUnavailable": true
        },
        "name": "Unkeep test run",
        "description": "Remove the retention flag from the selected test run",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1008"
      },
      "downloadRun": {
        "component": "OperationButton",
        "type": "platform:AutotestRun",
        "target": "selected",
        "operation": "autotestRun.download",
        "config": {
          "type": "default",
          "size": "small"
        },
        "name": "Download test run archive",
        "description": "Download the selected test run results and case artifacts as a ZIP archive",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1009"
      },
      "deleteRun": {
        "component": "OperationButton",
        "type": "platform:AutotestRun",
        "target": "selected",
        "operation": "autotestRun.delete",
        "config": {
          "type": "danger",
          "plain": true,
          "size": "small",
          "icon": "trash"
        },
        "name": "Delete test run",
        "description": "Delete the selected test run after confirming impact; disabled with reason while the run is active",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1010"
      },
      "results": {
        "component": "ObjectList",
        "type": "platform:AutotestRun",
        "target": "selected",
        "data": {
          "rows": {
            "read": "results",
            "params": {
              "verdict": {
                "state": "verdict"
              }
            }
          }
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "showChevron": false,
          "showFooter": true,
          "fallbackToFirst": false,
          "rowToneField": "verdict",
          "rowToneMap": {
            "wrong": "danger",
            "abnormal": "warning"
          },
          "emptyText": "results.empty",
          "noMatchText": "results.noMatch",
          "columns": [
            {
              "key": "caseId",
              "labelKey": "results.colCaseId",
              "width": 100
            },
            {
              "key": "question",
              "labelKey": "results.colQuestion",
              "minWidth": 240,
              "emptyKey": "common.dash"
            },
            {
              "key": "statusLabel",
              "labelKey": "results.colStatus",
              "kind": "tag",
              "width": 112
            },
            {
              "key": "verdictLabel",
              "labelKey": "results.colVerdict",
              "kind": "tag",
              "width": 100
            },
            {
              "key": "reason",
              "labelKey": "results.colReason",
              "minWidth": 160,
              "emptyKey": "common.dash"
            },
            {
              "key": "durationText",
              "labelKey": "results.colDuration",
              "width": 90,
              "align": "right"
            }
          ]
        },
        "name": "Test case results",
        "description": "Case execution outcomes for the selected test run filtered by verdict; clicking a row opens the corresponding AutotestCaseArtifact",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1011"
      }
    }
  },
