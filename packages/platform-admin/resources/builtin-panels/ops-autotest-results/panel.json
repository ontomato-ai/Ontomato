{
  "manifest": {
    "state": {
      "selected": {
        "type": {
          "kind": "object",
          "objectType": "platform:AutotestRun"
        },
        "deepLink": true
      },
      "search": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": ""
      },
      "verdict": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": "all"
      },
      "caseDetailPath": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": false,
        "external": true,
        "default": "/ops/autotest/case"
      }
    },
    "members": {
      "runs": {
        "component": "ObjectList",
        "type": "platform:AutotestRun",
        "data": {
          "rows": "list"
        },
        "state": {
          "selected": "selected",
          "search": "search"
        },
        "config": {
          "layout": "cards",
          "statusField": "statusLabel",
          "subtitleField": "summaryLine",
          "subtitleLines": 2,
          "fallbackToFirst": true,
          "searchable": true,
          "searchPlaceholder": "runs.searchPlaceholder",
          "searchFields": [
            "label",
            "caseSetName",
            "runId",
            "statusLabel",
            "keptLabel",
            "summaryLine"
          ],
          "emptyText": "runs.empty",
          "emptyHint": "runs.emptyHint",
          "noMatchText": "runs.noMatch",
          "showFooter": false,
          "columns": [
            {
              "key": "keptLabel",
              "labelKey": "runs.colRetention",
              "kind": "tag",
              "emptyKey": "common.dash"
            },
            {
              "key": "startedAt",
              "labelKey": "runs.colStartedAt",
              "kind": "time",
              "timeFormat": "relative"
            }
          ]
        },
        "name": "Test runs",
        "description": "List of automatic test runs with case set name, status badge, retention flag, summary, and timestamp",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1001"
      },
      "runHeader": {
        "component": "ObjectHeader",
        "type": "platform:AutotestRun",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "subtitleField": "runId",
          "statusField": "statusLabel"
        },
        "name": "Test run header",
        "description": "Selected test run title, status badge, run identifier, and read-only lifecycle outputs",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1002"
      },
      "runKept": {
        "component": "TypedValue",
        "type": "platform:AutotestRun",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "field": "keptLabel",
          "kind": "tag",
          "emptyText": ""
        },
        "name": "Test run retention badge",
        "description": "Displays the retention tag when the selected test run is marked as kept",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1003"
      },
      "runStartedAt": {
        "component": "TypedValue",
        "type": "platform:AutotestRun",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "field": "startedAt",
          "kind": "datetime",
          "emptyKey": "common.dash"
        },
        "name": "Test run start time",
        "description": "Localized start timestamp of the selected test run",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1004"
      },
      "runFinishedAt": {
        "component": "TypedValue",
        "type": "platform:AutotestRun",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "field": "finishedAt",
          "kind": "datetime",
          "emptyKey": "common.dash"
        },
        "name": "Test run completion time",
        "description": "Localized completion timestamp of the selected test run",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1005"
      },
      "runMetrics": {
        "component": "MetricCard",
        "type": "platform:AutotestRun",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "variant": "compact",
          "columns": 6,
          "items": [
            {
              "field": "total",
              "labelKey": "metrics.total"
            },
            {
              "field": "correct",
              "labelKey": "metrics.correct",
              "tone": "success"
            },
            {
              "field": "wrong",
              "labelKey": "metrics.wrong",
              "tone": "danger"
            },
            {
              "field": "abnormal",
              "labelKey": "metrics.abnormal",
              "tone": "warning"
            },
            {
              "field": "accuracyRate",
              "labelKey": "metrics.accuracyRate",
              "tone": "info"
            },
            {
              "field": "avgDuration",
              "labelKey": "metrics.avgDuration"
            }
          ]
        },
        "name": "Test run summary metrics",
        "description": "Owner-computed totals, verdict counts, accuracy rate, and average duration for the selected test run",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1006"
      },
      "keepRun": {
        "component": "OperationButton",
        "type": "platform:AutotestRun",
        "target": "selected",
        "operation": "autotestRun.keep",
        "config": {
          "type": "default",
          "size": "small",
          "hideWhenUnavailable": true
        },
        "name": "Keep test run",
        "description": "Mark the selected test run as kept so retention cleanup preserves its artifacts",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1007"
      },
      "unkeepRun": {
        "component": "OperationButton",
        "type": "platform:AutotestRun",
        "target": "selected",
        "operation": "autotestRun.unkeep",
        "config": {
          "type": "default",
          "size": "small",
          "hideWhenUnavailable": true
        },
        "name": "Unkeep test run",
        "description": "Remove the retention flag from the selected test run",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1008"
      },
      "downloadRun": {
        "component": "OperationButton",
        "type": "platform:AutotestRun",
        "target": "selected",
        "operation": "autotestRun.download",
        "config": {
          "type": "default",
          "size": "small"
        },
        "name": "Download test run archive",
        "description": "Download the selected test run results and case artifacts as a ZIP archive",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1009"
      },
      "deleteRun": {
        "component": "OperationButton",
        "type": "platform:AutotestRun",
        "target": "selected",
        "operation": "autotestRun.delete",
        "config": {
          "type": "danger",
          "plain": true,
          "size": "small",
          "icon": "trash"
        },
        "name": "Delete test run",
        "description": "Delete the selected test run after confirming impact; disabled with reason while the run is active",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1010"
      },
      "results": {
        "component": "ObjectList",
        "type": "platform:AutotestRun",
        "target": "selected",
        "data": {
          "rows": {
            "read": "results",
            "params": {
              "verdict": {
                "state": "verdict"
              }
            }
          }
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "showChevron": true,
          "showFooter": true,
          "fallbackToFirst": false,
          "emptyText": "results.empty",
          "noMatchText": "results.noMatch",
          "columns": [
            {
              "key": "caseId",
              "labelKey": "results.colCaseId",
              "width": 78
            },
            {
              "key": "question",
              "labelKey": "results.colQuestion",
              "minWidth": 170,
              "emptyKey": "common.dash"
            },
            {
              "key": "statusLabel",
              "labelKey": "results.colStatus",
              "kind": "tag",
              "width": 78
            },
            {
              "key": "verdictLabel",
              "labelKey": "results.colVerdict",
              "kind": "tag",
              "width": 76
            },
            {
              "key": "durationText",
              "labelKey": "results.colDuration",
              "width": 74,
              "align": "right"
            },
            {
              "key": "reason",
              "labelKey": "results.colReason",
              "minWidth": 130,
              "emptyKey": "common.dash"
            }
          ],
          "rowActions": {
            "maxVisible": 1,
            "items": [
              {
                "kind": "local",
                "id": "openArtifact",
                "labelKey": "results.openArtifact",
                "primary": true
              }
            ]
          }
        },
        "name": "Test case results",
        "description": "Case execution outcomes for the selected test run filtered by verdict; selecting a row or action opens the corresponding AutotestCaseArtifact",
        "id": "builtin-product-9c4f1e20-6a8b-4d3e-8f12-3a7b9c5d1011"
      }
    }
  },
