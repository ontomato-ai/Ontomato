{
  "manifest": {
    "state": {
      "domain": {
        "type": {
          "kind": "object",
          "objectType": "platform:ModelUsage"
        },
        "external": true
      }
    },
    "members": {
      "usageForm": {
        "component": "ObjectForm",
        "type": "platform:ModelUsage",
        "target": "domain",
        "data": {
          "form": "form"
        },
        "operation": "platform:ModelUsage.save",
        "config": {
          "layout": "rows",
          "actions": "none"
        },
        "name": "Domain model defaults",
        "description": "Select the domain's default chat model and embedding model",
        "id": "builtin-product-8c7a3f1e-4b2d-4c9a-9e11-200000000001"
      },
      "vectorStatus": {
        "component": "InfoBanner",
        "type": "platform:ModelUsage",
        "target": "domain",
        "data": {
          "record": "vectorRebuild"
        },
        "config": {
          "field": "message",
          "toneField": "tone",
          "toneMap": {
            "info": "info",
            "success": "success",
            "warning": "warning",
            "danger": "danger"
          }
        },
        "name": "Vector rebuild status",
        "description": "Current domain vector index rebuild status, progress, and failure detail",
        "id": "builtin-product-8c7a3f1e-4b2d-4c9a-9e11-200000000002"
      },
      "rebuildVectors": {
        "component": "OperationButton",
        "type": "platform:ModelUsage",
        "target": "domain",
        "operation": "modelUsage.rebuildVectors",
        "name": "Rebuild vectors",
        "description": "Start or resume rebuilding all domain vectors",
        "id": "builtin-product-8c7a3f1e-4b2d-4c9a-9e11-200000000003"
      },
      "pauseVectorRebuild": {
        "component": "OperationButton",
        "type": "platform:ModelUsage",
        "target": "domain",
        "operation": "modelUsage.pauseVectorRebuild",
        "name": "Pause vector rebuild",
        "description": "Pause an active vector rebuild after the current item",
        "id": "builtin-product-8c7a3f1e-4b2d-4c9a-9e11-200000000004"
      },
      "agentUsages": {
        "component": "ObjectList",
        "type": "platform:ModelUsage",
        "target": "domain",
        "data": {
          "rows": "agentUsages"
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "fallbackToFirst": false,
          "emptyText": "agents.empty",
          "columns": [
            {
              "key": "agent",
              "labelKey": "agents.colAgent",
              "minWidth": 180
            },
            {
              "key": "model",
              "labelKey": "agents.colModel",
              "minWidth": 200
            },
            {
              "key": "status",
              "labelKey": "agents.colStatus",
              "kind": "tag",
              "width": 140
            }
          ]
        },
        "name": "Ontology agent model usage",
        "description": "Models currently selected by ontology service agents",
        "id": "builtin-product-8c7a3f1e-4b2d-4c9a-9e11-200000000005"
      }
    }
  },
