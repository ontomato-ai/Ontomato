{
  "manifest": {
    "state": {
      "sessionId": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      },
      "pane": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": "full"
      },
      "selectedSession": {
        "type": {
          "kind": "object",
          "objectType": "platform:AgentSession"
        }
      },
      "sessionLimit": {
        "type": {
          "kind": "scalar",
          "type": "number"
        },
        "default": 20
      }
    },
    "members": {
      "content": {
        "target": {
          "fromPlatform": "currentEntry",
          "candidates": {
            "rule": "applicationEntry"
          }
        }
      },
      "chat": {
        "id": "builtin-product-ops-frame-chat",
        "component": "AgentChat",
        "agent": {
          "kind": "preset",
          "agentKind": "ops-diagnosis"
        },
        "state": {
          "sessionId": "sessionId"
        },
        "config": {
          "showHeader": false,
          "greetingKey": "chat.greeting",
          "descriptionKey": "chat.description",
          "placeholderKey": "chat.placeholder"
        },
        "name": "Operations diagnosis conversation",
        "description": "Persistent operations diagnosis AgentChat shared across pure-chat, side-by-side, and floating-composer states."
      },
      "recentSessions": {
        "id": "builtin-product-ops-frame-recent-sessions",
        "component": "ObjectList",
        "type": "platform:AgentSession",
        "data": {
          "rows": {
            "read": "list",
            "params": {
              "agentKind": {
                "literal": "ops-diagnosis"
              },
              "limit": {
                "state": "sessionLimit"
              }
            }
          }
        },
        "state": {
          "selected": "selectedSession"
        },
        "operations": {
          "rename": {
            "type": "platform:AgentSession",
            "operation": "agentSessions.rename",
            "target": "row"
          },
          "delete": {
            "type": "platform:AgentSession",
            "operation": "agentSessions.delete",
            "target": "row"
          }
        },
        "config": {
          "layout": "list",
          "searchable": false,
          "showHeader": false,
          "showFooter": false,
          "fallbackToFirst": false,
          "statusField": "runningStatus",
          "statusStyle": "dot",
          "emptyText": "recent.empty",
          "rowActions": {
            "maxVisible": 0,
            "items": [
              {
                "kind": "operation",
                "operation": "rename",
                "labelKey": "recent.rename",
                "icon": "pencil"
              },
              {
                "kind": "operation",
                "operation": "delete",
                "labelKey": "recent.delete",
                "icon": "trash-2",
                "tone": "danger"
              }
            ]
          }
        },
        "name": "Recent diagnosis sessions",
        "description": "Current reader's recent operations diagnosis conversations with live running indicator, rename, and delete actions."
      }
    }
  },
