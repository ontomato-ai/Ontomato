      "selected": {
        "type": {
          "kind": "object",
          "objectType": "platform:TurnEvidence"
        },
        "deepLink": true
      },
      "search": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      },
      "filePath": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      },
      "fileSearch": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      }
    },
    "members": {
      "buildTurn": {
        "component": "OperationButton",
        "type": "platform:TurnEvidence",
        "operation": "turnEvidence.build",
        "config": {
          "type": "primary",
          "labelKey": "panel.buildTurn"
        },
        "name": "Collect turn evidence",
        "description": "Collect or rebuild an evidence workspace for a Turn key (threadId/turnId).",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1001"
      },
      "turns": {
        "component": "ObjectList",
        "type": "platform:TurnEvidence",
        "data": {
          "rows": "list"
        },
        "state": {
          "selected": "selected",
          "search": "search"
        },
        "config": {
          "layout": "cards",
          "statusField": "statusLabel",
          "subtitleField": "turnKey",
          "subtitleLines": 1,
          "searchPlaceholder": "panel.searchPlaceholder",
          "emptyText": "panel.emptyList",
          "emptyHint": "panel.emptyListHint",
          "noMatchText": "panel.noMatch",
          "columns": [
            {
              "key": "keptLabel",
              "labelKey": "panel.colRetention",
              "kind": "tag"
            },
            {
              "key": "createdAt",
              "labelKey": "panel.colCreatedAt",
              "kind": "time"
            }
          ]
        },
        "name": "Turn evidence list",
        "description": "Searchable list of collected turn evidence workspaces ordered by retention and recency.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1002"
      },
      "detailHeader": {
        "component": "ObjectHeader",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "subtitleField": "turnKey",
          "statusField": "statusLabel"
        },
        "name": "Selected turn header",
        "description": "Displays the selected turn question summary, turn key, status badge, and read-only record outputs.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1003"
      },
      "createdAt": {
        "component": "TypedValue",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "field": "createdAt",
          "kind": "datetime",
          "emptyText": ""
        },
        "name": "Turn creation time",
        "description": "Localized creation timestamp of the selected turn evidence workspace.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1004"
      },
      "diagnose": {
        "component": "ConversationEntry",
        "agent": "page-default",
        "prefillKey": "panel.diagnosePrefill",
        "config": {
          "type": "primary",
          "labelKey": "panel.diagnose"
        },
        "name": "Diagnose this turn",
        "description": "Open the operations diagnosis assistant composer prefilled to diagnose the selected turn evidence.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1005"
      },
      "refreshTurn": {
        "component": "OperationButton",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "operation": "turnEvidence.refresh",
        "config": {
          "type": "default"
        },
        "name": "Refresh evidence",
        "description": "Re-collect evidence references for the selected turn.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1006"
      },
      "keepTurn": {
        "component": "OperationButton",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "operation": "turnEvidence.keep",
        "config": {
          "type": "default",
          "hideWhenUnavailable": true
        },
        "name": "Keep workspace",
        "description": "Mark the selected turn evidence workspace as kept to protect it from automatic cleanup.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1007"
      },
      "unkeepTurn": {
        "component": "OperationButton",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "operation": "turnEvidence.unkeep",
        "config": {
          "type": "default",
          "hideWhenUnavailable": true
        },
        "name": "Unkeep workspace",
        "description": "Remove the retention keep mark from the selected turn evidence workspace.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1008"
      },
      "downloadTurn": {
        "component": "OperationButton",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "operation": "turnEvidence.download",
        "config": {
          "type": "default"
        },
        "name": "Download ZIP",
        "description": "Download the selected turn evidence workspace as a ZIP archive.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1009"
      },
      "deleteTurn": {
        "component": "OperationButton",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "operation": "turnEvidence.delete",
        "config": {
          "type": "danger",
          "plain": true,
          "icon": "trash"
        },
        "name": "Delete workspace",
        "description": "Delete the selected turn evidence workspace after impact confirmation.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1010"
      },
      "evidenceBanner": {
        "component": "InfoBanner",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "field": "evidenceHint",
          "toneField": "hasEvidence",
          "toneMap": {
            "true": "info",
            "false": "warning"
          },
          "compact": true,
          "hideWhenEmpty": true
        },
        "name": "Evidence reference notice",
        "description": "Explains whether this workspace holds current runtime evidence references or needs refresh.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1011"
      },
      "detailSummary": {
        "component": "ObjectSummary",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "showTitle": false,
          "fields": [
            "turnKey",
            "statusLabel",
            "keptLabel",
            "createdAt"
          ],
          "copyableFields": [
            "turnKey"
          ]
        },
        "name": "Turn metadata summary",
        "description": "Displays the selected turn key, status, retention state, and creation timestamp.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1012"
      },
      "evidenceGaps": {
        "component": "ObjectList",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "data": {
          "rows": "evidenceGaps"
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "showFooter": false,
          "emptyText": "panel.gapsEmpty",
          "columns": [
            {
              "key": "source",
              "labelKey": "panel.colSource"
            },
            {
              "key": "code",
              "labelKey": "panel.colCode"
            },
            {
              "key": "message",
              "labelKey": "panel.colMessage",
              "wrap": true
            }
          ]
        },
        "name": "Evidence gaps",
        "description": "Lists missing evidence sources or collection warnings recorded for the selected turn.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1013"
      },
      "evidenceRuns": {
        "component": "ObjectList",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "data": {
          "rows": "evidenceRuns"
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "showFooter": false,
          "emptyText": "panel.runsEmpty",
          "columns": [
            {
              "key": "owner",
              "labelKey": "panel.colOwner"
            },
            {
              "key": "sessionId",
              "labelKey": "panel.colSessionId"
            },
            {
              "key": "runId",
              "labelKey": "panel.colRunId"
            },
            {
              "key": "artifactIds",
              "labelKey": "panel.colArtifacts",
              "wrap": true
            }
          ]
        },
        "name": "Evidence runs",
        "description": "Lists runtime runs and artifact IDs referenced by the selected turn evidence package.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1014"
      },
      "evidenceJson": {
        "component": "TypedValue",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "field": "evidenceJson",
          "kind": "code",
          "emptyText": ""
        },
        "name": "Raw evidence references",
        "description": "Formatted JSON snapshot of the resolved evidence references for inspection.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1015"
      },
      "fileTree": {
        "component": "ObjectTree",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "data": {
          "files": "files"
        },
        "state": {
          "selected": "filePath",
          "search": "fileSearch"
        },
        "config": {
          "fallbackToFirst": true,
          "searchable": true,
          "searchPlaceholder": "panel.fileSearchPlaceholder",
          "label": "panel.filesTitle",
          "emptyText": "panel.filesEmpty",
          "noMatchText": "panel.filesNoMatch"
        },
        "name": "Artifact files",
        "description": "Searchable directory tree of artifact files in the selected turn workspace.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1016"
      },
      "fileViewer": {
        "component": "ObjectTextReader",
        "type": "platform:TurnEvidence",
        "target": "selected",
        "data": {
          "record": {
            "read": "file",
            "params": {
              "path": {
                "state": "filePath"
              }
            }
          }
        },
        "state": {
          "activePath": "filePath"
        },
        "config": {
          "format": "auto",
          "textField": "content",
          "pathField": "path",
          "emptyText": "panel.fileSelectHint"
        },
        "name": "Artifact file viewer",
        "description": "Renders the selected artifact file automatically as Markdown, JSON/code, CSV/TSV table, or plain text.",
        "id": "builtin-product-9d3e5b21-4c7a-4e8f-b120-7a9c3e5f1017"
      }
    }
  },
