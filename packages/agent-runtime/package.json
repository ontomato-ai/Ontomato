{
  "name": "@ontomato/agent-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --exclude '**/sandbox-linux.integration.test.ts' integration",
    "test:sandbox": "vitest run src/__tests__/sandbox-linux.integration.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@ontomato/contracts": "workspace:*",
    "express": "4.22.1",
    "pg": "8.20.0",
    "typebox": "1.3.27",
    "yaml": "2.8.3",
    "zod": "3.25.76",
    "@ontomato/service-logging": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.19.15",
    "@types/pg": "8.20.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "1.6.0"
  }
}
