        "config": {
          "layout": "cards",
          "searchable": false,
          "showFooter": false,
          "leadingIconField": "icon",
          "leadingIconKind": "agent",
          "openOutput": "openPath",
          "subtitleLines": 2,
          "emptyText": "panel.empty",
