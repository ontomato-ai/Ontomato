{
  "manifest": {
    "state": {
      "category": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "default": "all",
        "deepLink": true
      },
      "search": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      }
    },
    "members": {
      "applications": {
        "component": "ObjectList",
        "type": "platform:Application",
        "data": {
          "rows": "available"
        },
        "state": {
          "category": "category",
          "search": "search"
        },
        "operations": {
          "favorite": {
            "type": "platform:Favorite",
            "operation": "favorites.add",
            "target": {
              "row": true
            }
          },
          "unfavorite": {
            "type": "platform:Favorite",
            "operation": "favorites.remove",
            "target": {
              "row": true
            }
          }
        },
        "config": {
          "layout": "cards",
          "searchable": false,
          "showFooter": false,
          "leadingIconField": "icon",
          "leadingIconKind": "application",
          "openOutput": "openPath",
          "subtitleLines": 2,
          "emptyText": "panel.empty",
          "noMatchText": "panel.empty",
          "rowActions": {
            "placement": "header",
            "maxVisible": 1,
            "items": [
              {
                "kind": "operation",
                "operation": "favorite",
                "labelKey": "panel.addFavorite",
                "icon": "star",
                "iconOnly": true,
                "when": {
                  "field": "favorite",
                  "equals": false
                }
              },
              {
                "kind": "operation",
                "operation": "unfavorite",
                "labelKey": "panel.removeFavorite",
                "icon": "star-filled",
                "iconOnly": true,
                "active": true,
                "when": {
                  "field": "favorite",
                  "equals": true
                }
              }
            ]
          }
        },
        "id": "builtin-product-6c1b4d8e-52f9-4a13-8c7b-39e6d04f1a21"
      },
      "agents": {
