{
  "manifest": {
    "state": {
      "dashboardId": {
        "type": {
          "kind": "object",
          "objectType": "platform:Dashboard"
        },
        "deepLink": true,
        "personal": false,
        "external": false
      },
      "cardId": {
        "type": {
          "kind": "object",
          "objectType": "platform:DashboardCard"
        },
        "deepLink": true,
        "personal": false,
        "external": false
      },
      "cardDialog": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": false
      }
    },
    "members": {
      "boardTabs": {
        "component": "ObjectList",
        "type": "platform:Dashboard",
        "data": {
          "rows": "list"
        },
        "state": {
          "selected": "dashboardId"
        },
        "operations": {
          "rename": "dashboards.rename",
          "remove": "dashboards.delete"
        },
        "config": {
          "layout": "tabs",
          "tabsVariant": "pill",
          "inlineRename": true,
          "inlineRenameOperation": "rename",
          "inlineRenameField": "name",
          "searchable": false,
          "showFooter": false,
          "fallbackToFirst": true,
          "emptyText": "empty.noBoards",
          "rowActions": {
            "maxVisible": 0,
            "items": [
              {
                "kind": "operation",
                "operation": "rename",
                "labelKey": "board.rename",
                "prefill": true
              },
              {
                "kind": "operation",
                "operation": "remove",
                "labelKey": "board.delete",
                "danger": true
              }
            ]
          }
        },
        "name": "Dashboard tabs",
        "description": "Horizontal tab strip of saved dashboards with rename and delete actions",
        "id": "builtin-product-db10a000-4e3b-4000-8000-000000000001"
      },
      "createBoard": {
        "component": "OperationButton",
        "type": "platform:Dashboard",
        "operation": "dashboards.create",
        "config": {
          "labelKey": "board.create"
        },
        "name": "Create dashboard",
        "description": "Create a new empty dashboard",
        "id": "builtin-product-db10a000-4e3b-4000-8000-000000000002"
      },
      "boardGrid": {
        "component": "GroupedGrid",
        "type": "platform:Dashboard",
        "target": "dashboardId",
        "data": {
          "record": "record",
          "rows": "cards"
        },
        "state": {
          "selected": "cardId"
        },
        "operations": {
          "renameCard": {
            "operation": "dashboardCards.rename",
            "type": "platform:DashboardCard",
            "target": "row"
          },
          "deleteCard": {
            "operation": "dashboardCards.delete",
            "type": "platform:DashboardCard",
            "target": "row"
          },
          "saveLayout": "dashboards.saveLayout",
          "createGroup": "dashboards.createGroup",
          "renameGroup": "dashboards.renameGroup",
          "deleteGroup": "dashboards.deleteGroup",
          "renameBoard": "dashboards.rename"
        },
        "config": {
          "columns": 12,
          "sectionColumns": {
            "metric": 12,
            "chart": 24
          },
          "rowHeight": 102,
          "sectionRowHeights": {
            "metric": 102,
            "chart": 360
          },
          "minColSpan": 1,
          "sectionMinColSpans": {
            "metric": 1,
            "chart": 4
          },
          "sectionResizeAxes": {
            "metric": "horizontal",
            "chart": "both"
          },
          "gap": 14,
          "groupsField": "groups",
          "groupKeyField": "groupId",
          "groupTitleField": "groupTitle",
          "sectionField": "kind",
          "sectionOrder": [
            "metric",
            "chart"
          ],
          "colSpanField": "colSpan",
          "rowSpanField": "rowSpan",
          "orderField": "order",
          "editable": true,
          "collapsible": false,
          "groupSurface": "card",
          "itemHeaderDivider": {
            "metric": "none",
            "chart": "line"
          },
          "controlsVisibility": "hover",
          "saveOperation": "saveLayout",
          "rowActions": {
            "maxVisible": 0,
            "items": [
              {
                "kind": "operation",
                "operation": "renameCard",
                "labelKey": "card.rename",
                "prefill": true
              },
              {
                "kind": "local",
                "id": "parameters",
                "labelKey": "card.parameters",
                "when": {
                  "field": "kind",
                  "equals": "metric"
                }
              },
              {
                "kind": "local",
                "id": "metricSource",
                "labelKey": "card.metricSource",
                "when": {
                  "field": "kind",
                  "equals": "metric"
                }
              },
              {
                "kind": "operation",
                "operation": "deleteCard",
                "labelKey": "card.delete",
                "danger": true
              }
            ]
          }
        },
        "name": "Dashboard grid",
        "description": "Grouped dashboard canvas (12-column metrics and 24-column charts) with drag reordering, resizing, draft preview, and group management",
        "id": "builtin-product-db10a000-4e3b-4000-8000-000000000003"
      },
      "chartCard": {
        "component": "MetricChart",
        "type": "platform:DashboardCard",
        "target": {
          "fromSlot": true
        },
        "data": {
          "template": "chartTemplate",
          "result": "result"
        },
        "config": {
          "minHeight": "100%",
          "allowViewToggle": false,
          "allowZoom": false,
          "tableMaxRows": 500,
          "truncationDisplay": "none"
        },
        "name": "Chart card",
        "description": "Independent chart projection for one dashboard chart card",
        "id": "builtin-product-db10a000-4e3b-4000-8000-000000000004"
      },
      "metricCard": {
        "component": "MetricCard",
        "type": "platform:DashboardCard",
        "target": {
          "fromSlot": true
        },
        "data": {
          "result": "result"
        },
        "config": {
          "surface": "bare",
          "showLabel": false,
          "valueSize": "large",
          "truncationDisplay": "none"
        },
        "name": "Metric card",
        "description": "Independent KPI metric projection for one dashboard numeric card",
        "id": "builtin-product-db10a000-4e3b-4000-8000-000000000005"
      },
      "cardParamForm": {
        "component": "ObjectForm",
        "type": "platform:DashboardCard",
        "target": "cardId",
        "data": {
          "form": "form"
        },
        "operation": "platform:DashboardCard.save",
        "config": {
          "showChangeSummary": true
        },
        "name": "Card parameters form",
        "description": "Edit and save MetricView query parameters for the selected dashboard card",
        "id": "builtin-product-db10a000-4e3b-4000-8000-000000000006"
      },
      "cardMetricSource": {
        "component": "ObjectSummary",
        "type": "platform:DashboardCard",
        "target": "cardId",
        "data": {
          "record": "metricSource"
        },
        "config": {
          "showTitle": false,
          "bordered": true,
          "columns": 1,
          "keyValueFields": [
            "parameters"
          ],
          "fields": [
            "metric",
            "status",
            "parameters"
          ]
        },
        "name": "Card metric source",
        "description": "Inspect the backing MetricView, status, and saved parameters of the selected card",
        "id": "builtin-product-db10a000-4e3b-4000-8000-000000000007"
      },
      "cardMetricOpen": {
        "component": "ObjectRefCard",
        "type": "platform:DashboardCard",
        "target": "cardId",
        "data": {
          "record": "metricSource"
        },
        "config": {
          "field": "metric",
          "appearance": "button",
          "buttonType": "primary",
          "buttonLabelKey": "dialog.openMetric"
        },
        "name": "Open metric",
        "description": "Open the backing MetricView detail page for the selected card",
        "id": "builtin-product-db10a000-4e3b-4000-8000-000000000008"
      }
    }
  },
