{
  "name": "@ontomato/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./chart-data": "./src/chart-data/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/chart-data/*.node-test.ts src/chart-import.node-test.ts",
    "generate:query-package": "node --import tsx scripts/query-package-schema.mjs",
    "generate:query-subgraph": "node scripts/query-subgraph-schema.mjs",
    "check:query-subgraph": "node scripts/check-query-subgraph.mjs",
    "check:platform-schedules": "node --import tsx --test scripts/platform-schedules.node-test.mjs"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "zod-to-json-schema": "3.25.2"
  }
}
