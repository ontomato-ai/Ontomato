{
  "server": {
    "port": 18087,
    "max-http-post-size": "100MB"
  },
  "spring": {
    "servlet": {
      "multipart": {
        "max-file-size": "100MB",
        "max-request-size": "200MB"
      }
    }
  },
  "langchain4j": {
    "open-ai": {
      "models": [
        {
          "name": "main",
          "displayName": "Main",
          "modelName": "api-main",
          "connectionConfigured": true,
          "timeout": "PT1M30S",
          "maxRetries": 2,
          "maxTokens": 4000,
          "contextWindow": 64000
        }
      ],
      "agents": {
        "query": {
          "model": "main"
        },
        "coding": {
          "model": "main"
        },
        "general": {
          "model": "main"
        },
        "diagnosis": {
          "model": "main"
        },
        "knowledgeGovernance": {
          "model": null
        }
      },
      "embedding-model": {
        "modelName": "emb",
        "apiKeyConfigured": true,
        "timeout": "PT5M"
      }
    }
  },
  "ontomato": {
    "data-engine": {
      "dataAdapter": "postgresql",
      "knowledgeMaxResult": 7,
      "dslCookerTimeout": 300000
    }
  },
  "subQueryCacheDir": "/srv/datarag/conf/subQueryCache"
}
