{
  "manifest": {
    "state": {
      "mode": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": "instance"
      },
      "view": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": "graph"
      },
      "start": {
        "type": {
          "kind": "object",
          "objectType": "@any"
        },
        "deepLink": true
      },
      "selected": {
        "type": {
          "kind": "object",
          "objectType": "@any"
        },
        "deepLink": true
      },
      "selectedType": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      },
      "selectedTypeRef": {
        "type": {
          "kind": "object-union",
          "objectTypes": [
            "platform:ObjectType",
            "platform:OntologyType"
          ]
        }
      },
      "selectedRelation": {
        "type": {
          "kind": "object-union",
          "objectTypes": [
            "platform:Relationship",
            "platform:OntologyRelationKind"
          ]
        },
        "deepLink": true
      },
      "selectedClass": {
        "type": {
          "kind": "object-union",
          "objectTypes": [
            "platform:ObjectType",
            "platform:OntologyType"
          ]
        }
      },
      "exploreTypeRequest": {
        "type": {
          "kind": "object-union",
          "objectTypes": [
            "platform:ObjectType",
            "platform:OntologyType"
          ]
        }
      }
    },
    "members": {
      "types": {
        "target": {
          "panelId": "builtin-product-ontology-graph"
        },
        "inputs": {
          "dataSource": {
            "literal": "platform"
          },
          "objectType": {
            "state": "selectedTypeRef"
          },
          "relation": {
            "state": "selectedRelation"
          }
        },
        "outputs": {
          "objectType": {
            "state": "selectedTypeRef"
          },
          "relation": {
            "state": "selectedRelation"
          },
          "exploreTypeRequest": {
            "state": "exploreTypeRequest"
          }
        }
      },
      "instances": {
        "target": {
          "panelId": "builtin-product-data-browser"
        },
        "inputs": {
          "dataSource": {
            "literal": "platform"
          },
          "viewMode": {
            "state": "view"
          },
          "graphStart": {
            "state": "start"
          },
          "selectedNode": {
            "state": "selected"
          },
          "selectedClass": {
            "state": "selectedClass"
          }
        },
        "outputs": {
          "viewMode": {
            "state": "view"
          },
          "graphStart": {
            "state": "start"
          },
          "selectedNode": {
            "state": "selected"
          },
          "selectedClass": {
            "state": "selectedClass"
          }
        }
      }
    }
  },
  "content": {
