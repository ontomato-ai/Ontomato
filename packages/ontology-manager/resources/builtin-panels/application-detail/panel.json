      },
      "grantSubmit": {
        "component": "OperationButton",
        "type": "platform:Application",
        "target": "selected",
        "operation": "applications.grant",
        "operationParams": {
          "principalKind": {
            "state": "grantPrincipalKind"
          },
          "principalId": {
            "state": "grantPrincipalId"
          },
          "verb": {
            "state": "grantVerb"
          },
          "remove": {
            "literal": false
          }
        },
        "config": {
          "type": "primary",
          "labelKey": "grants.submit"
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a11"
      },
      "shareEnable": {
        "component": "OperationButton",
        "type": "platform:Application",
        "target": "selected",
        "operation": "applications.share",
        "operationParams": {
          "shared": {
            "literal": true
          }
        },
        "config": {
          "size": "small",
          "labelKey": "grants.enableShare"
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a12"
      },
      "shareDisable": {
        "component": "OperationButton",
        "type": "platform:Application",
        "target": "selected",
        "operation": "applications.share",
        "operationParams": {
          "shared": {
            "literal": false
          }
        },
        "config": {
          "size": "small",
          "labelKey": "grants.disableShare"
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a13"
      },
      "shareStatusDesc": {
        "component": "TypedValue",
        "type": "platform:Application",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "field": "domainShared",
          "kind": "text",
          "valueMap": {
            "true": {
              "labelKey": "grants.sharedDesc"
            },
            "false": {
              "labelKey": "grants.privateDesc"
            }
          }
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a14"
      },
      "deleteApp": {
        "component": "OperationButton",
        "type": "platform:Application",
        "target": "selected",
        "operation": "applications.delete",
        "config": {
          "type": "danger",
          "plain": true,
          "icon": "trash",
          "hideWhenUnavailable": true
        },
        "id": "builtin-product-6391d99c-9f5a-4f5e-8958-efc070e8c5f2"
      }
    }
