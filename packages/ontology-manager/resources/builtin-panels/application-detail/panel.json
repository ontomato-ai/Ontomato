        "data": {
          "form": {
            "read": "form",
            "params": {
              "section": {
                "literal": "entries"
              }
            }
          }
        },
        "operation": "platform:Application.save",
        "config": {
          "actions": "footer"
        },
        "id": "builtin-product-fe66a20c-a476-4988-ac4d-d42dfaa1908a"
      },
      "usedPanelsList": {
        "component": "ObjectList",
        "type": "platform:Application",
        "target": "selected",
        "data": {
          "rows": "usedPanels"
        },
        "state": {
          "selected": "inspectedPanel"
        },
        "config": {
          "layout": "list",
          "searchable": false,
          "fallbackToFirst": true,
          "emptyText": "assets.noPanels",
          "subtitleField": "subtitle"
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a0c"
      },
      "panelMembersList": {
        "component": "ObjectList",
        "type": "platform:ProductPanel",
        "target": "inspectedPanel",
        "data": {
          "rows": "memberRows"
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "fallbackToFirst": false,
          "emptyText": "assets.noMembers",
          "columns": [
            {
              "key": "target",
              "labelKey": "assets.colTarget",
              "kind": "reference",
              "minWidth": 200
            },
            {
              "key": "kindLabel",
              "labelKey": "assets.colKind",
              "kind": "tag",
              "width": 100
            },
            {
              "key": "slot",
              "labelKey": "assets.colSlot",
              "width": 140
            }
          ]
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a0d"
      },
      "grantsList": {
        "component": "ObjectList",
        "type": "platform:Application",
        "target": "selected",
        "data": {
          "rows": "grantRows"
        },
        "operations": {
          "revoke": {
            "operation": "applications.grant",
            "target": {
              "state": "selected"
            },
            "params": {
              "principalKind": {
                "rowField": "principalKind"
              },
              "principalId": {
                "rowField": "principalId"
              },
              "verb": {
                "rowField": "verb"
              },
              "remove": {
                "literal": true
              }
            }
          }
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "fallbackToFirst": false,
          "emptyText": "grants.none",
          "columns": [
            {
              "key": "principalKindLabel",
              "labelKey": "grants.kind",
              "kind": "tag",
              "width": 130
            },
            {
              "key": "label",
              "labelKey": "grants.principalCol",
