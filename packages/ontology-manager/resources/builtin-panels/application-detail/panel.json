      },
      "save": {
        "component": "ObjectForm",
        "type": "platform:Application",
        "target": "selected",
        "data": {
          "form": {
            "read": "form",
            "params": {
              "section": {
                "literal": "identity"
              }
            }
          }
        },
        "operation": "platform:Application.save",
        "config": {
          "actions": "none"
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a0a"
      },
      "entriesList": {
        "component": "ObjectList",
        "type": "platform:Application",
        "target": "selected",
        "data": {
          "rows": "entryRows"
        },
        "operations": {
          "deleteEntry": {
            "operation": "applications.deleteEntry",
            "target": {
              "state": "selected"
            },
            "params": {
              "entryId": {
                "row": "primaryKey"
              }
            }
          }
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "fallbackToFirst": false,
          "emptyText": "entries.empty",
          "columns": [
            {
              "key": "label",
              "labelKey": "entries.colName",
              "minWidth": 150
            },
            {
              "key": "path",
              "labelKey": "entries.colPath",
              "minWidth": 180
            },
            {
              "key": "panel",
              "labelKey": "entries.colPanel",
              "kind": "reference",
              "minWidth": 180
            },
            {
              "key": "group",
              "labelKey": "entries.colGroup",
              "width": 110
            },
            {
              "key": "access",
              "labelKey": "entries.colAccess",
              "width": 130
            },
            {
              "key": "defaultAgent",
              "labelKey": "entries.colAgent",
              "width": 130
            }
          ],
          "rowActions": {
            "labelKey": "entries.colActions",
            "width": 140,
            "align": "right",
            "maxVisible": 2,
            "items": [
              {
                "kind": "local",
                "id": "edit",
                "labelKey": "action.edit",
                "primary": true,
                "when": {
                  "field": "canEdit",
                  "equals": true
                }
              },
              {
                "kind": "operation",
                "operation": "deleteEntry",
                "labelKey": "action.delete",
                "danger": true,
                "when": {
                  "field": "canEdit",
                  "equals": true
                }
              }
            ]
          }
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a0b"
      },
      "entryForm": {
        "component": "ObjectForm",
        "type": "platform:Application",
        "target": "selected",
        "data": {
          "form": {
            "read": "form",
            "params": {
              "section": {
                "literal": "entry"
              },
              "entryId": {
                "state": "editingEntryId"
              }
            }
          }
        },
        "operation": "platform:Application.save",
        "config": {
          "actions": "footer"
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a04"
      },
      "entriesForm": {
        "component": "ObjectForm",
        "type": "platform:Application",
