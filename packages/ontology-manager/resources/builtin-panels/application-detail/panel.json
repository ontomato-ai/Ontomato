            "labelKey": "grants.actions",
            "width": 100,
            "align": "right",
            "maxVisible": 1,
            "items": [
              {
                "kind": "operation",
                "operation": "revoke",
                "labelKey": "grants.revoke",
                "danger": true,
                "when": {
                  "field": "revocable",
                  "equals": true
                }
              }
            ]
          }
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a0e"
      },
      "userPicker": {
        "component": "ReferencePicker",
