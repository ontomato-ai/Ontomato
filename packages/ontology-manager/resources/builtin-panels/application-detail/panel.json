{
  "manifest": {
    "state": {
      "selected": {
        "type": {
          "kind": "object",
          "objectType": "platform:Application"
        },
        "deepLink": true
      },
      "tab": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": "identity"
      },
      "entriesView": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": "list"
      },
      "editingEntryId": {
        "type": {
          "kind": "scalar",
          "type": "string"
        }
      },
      "inspectedPanel": {
        "type": {
          "kind": "object",
          "objectType": "platform:ProductPanel"
        },
        "deepLink": true
      },
      "copyDialog": {
        "type": {
          "kind": "scalar",
          "type": "boolean"
        },
        "default": false
      }
    },
    "members": {
      "headerTitle": {
        "component": "ObjectHeader",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "subtitle": ""
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a08"
      },
      "runtimeSummary": {
        "component": "ObjectSummary",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "showTitle": false,
          "fields": [
            "id",
            "source",
            "maintenance",
            "owner",
            "updatedAt",
            "path",
            "home",
            "renderer",
            "framePanel",
            "allowStandalone",
            "externalLink",
            "themeSummary"
          ],
          "copyableFields": [
            "externalLink"
          ]
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a09"
      },
      "summary": {
        "component": "ObjectSummary",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "showTitle": false,
          "fields": [
            "id",
            "names",
            "descriptions",
            "source",
            "maintenance",
            "owner",
            "updatedAt",
            "path",
            "home",
            "renderer",
            "framePanel",
            "allowStandalone",
            "externalLink",
            "themeSummary"
          ],
          "copyableFields": [
            "externalLink"
          ]
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a01"
      },
      "declarationSummary": {
        "component": "ObjectSummary",
        "target": "selected",
        "data": {
          "record": "record"
        },
        "config": {
          "showTitle": false,
          "fields": [
            "declarationJson"
          ],
          "copyableFields": [
            "declarationJson"
          ]
        },
        "name": "应用详情 · 完整公开声明",
        "description": "按读者可读权限展示当前应用的完整公开声明 JSON 并支持一键复制。",
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a21"
      },
      "copyForm": {
        "component": "ObjectForm",
        "target": "selected",
        "data": {
          "form": {
            "read": "form",
            "params": {
              "section": {
                "literal": "entry"
              },
              "entryId": {
                "literal": "__copy__"
              }
            }
          }
        },
        "operation": "platform:Application.save",
        "config": {
          "actions": "footer"
        },
        "name": "应用详情 · 复制应用表单",
        "description": "基于当前应用的允许复制入口声明与面板引用创建应用副本。",
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a22"
      },
      "save": {
        "component": "ObjectForm",
        "target": "selected",
        "data": {
          "form": {
            "read": "form",
            "params": {
              "section": {
                "literal": "identity"
              }
            }
          }
        },
        "operation": "platform:Application.save",
        "config": {
          "actions": "none"
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a0a"
      },
      "entriesList": {
        "component": "ObjectList",
        "target": "selected",
        "data": {
          "rows": "entryRows"
        },
        "operations": {
          "deleteEntry": {
            "operation": "applications.deleteEntry",
            "target": {
              "state": "selected"
            },
            "params": {
              "entryId": {
                "row": "primaryKey"
              }
            }
          }
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "fallbackToFirst": false,
          "emptyText": "entries.empty",
          "columns": [
            {
              "key": "label",
              "labelKey": "entries.colName",
              "minWidth": 150
            },
            {
              "key": "path",
              "labelKey": "entries.colPath",
              "minWidth": 180
            },
            {
              "key": "panel",
              "labelKey": "entries.colPanel",
              "kind": "reference",
              "minWidth": 180
            },
            {
              "key": "group",
              "labelKey": "entries.colGroup",
              "width": 110
            },
            {
              "key": "access",
              "labelKey": "entries.colAccess",
              "width": 130
            },
            {
              "key": "defaultAgent",
              "labelKey": "entries.colAgent",
              "width": 130
            }
          ],
          "rowActions": {
            "labelKey": "entries.colActions",
            "width": 140,
            "align": "right",
            "maxVisible": 2,
            "items": [
              {
                "kind": "local",
                "id": "edit",
                "labelKey": "action.edit",
                "tone": "primary",
                "when": {
                  "field": "canEdit",
                  "equals": true
                }
              },
              {
                "kind": "operation",
                "operation": "deleteEntry",
                "labelKey": "action.delete",
                "tone": "danger",
                "when": {
                  "field": "canEdit",
                  "equals": true
                }
              }
            ]
          }
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a0b"
      },
      "entryForm": {
        "component": "ObjectForm",
        "target": "selected",
        "data": {
          "form": {
            "read": "form",
            "params": {
              "section": {
                "literal": "entry"
              },
              "entryId": {
                "state": "editingEntryId"
              }
            }
          }
        },
        "operation": "platform:Application.save",
        "config": {
          "actions": "footer"
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a04"
      },
      "entriesForm": {
        "component": "ObjectForm",
        "target": "selected",
        "data": {
          "form": {
            "read": "form",
            "params": {
              "section": {
                "literal": "entries"
              }
            }
          }
        },
        "operation": "platform:Application.save",
        "config": {
          "actions": "footer"
        },
        "id": "builtin-product-fe66a20c-a476-4988-ac4d-d42dfaa1908a"
      },
      "referenceGraph": {
        "component": "ProductAssetGraph",
        "target": "selected",
        "data": {
          "graph": "referenceGraph"
        },
        "id": "builtin-product-7e2b9a43-5c18-4d6f-8a39-1f4b6c8d3093"
      },
      "usedPanelsList": {
        "component": "ObjectList",
        "target": "selected",
        "data": {
          "rows": "usedPanels"
        },
        "state": {
          "selected": "inspectedPanel"
        },
        "config": {
          "layout": "list",
          "searchable": false,
          "fallbackToFirst": true,
          "emptyText": "assets.noPanels",
          "subtitleField": "subtitle",
          "rowActions": {
            "maxVisible": 1,
            "items": [
              {
                "kind": "local",
                "id": "openPanel",
                "labelKey": "assets.openPanelShort",
                "tone": "primary",
                "when": {
                  "field": "accessible",
                  "equals": true
                }
              }
            ]
          }
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a0c"
      },
      "panelMembersList": {
        "component": "ObjectList",
        "target": "inspectedPanel",
        "data": {
          "rows": "memberRows"
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "fallbackToFirst": false,
          "emptyText": "assets.noMembers",
          "columns": [
            {
              "key": "target",
              "labelKey": "assets.colTarget",
              "kind": "reference",
              "minWidth": 200
            },
            {
              "key": "kindLabel",
              "labelKey": "assets.colKind",
              "kind": "tag",
              "width": 100
            },
            {
              "key": "slot",
              "labelKey": "assets.colSlot",
              "width": 140
            }
          ]
        },
        "id": "builtin-product-9a4e1c2b-7f05-4d8a-9c31-6e2b4d8f1a0d"
      },
      "deleteApp": {
        "component": "OperationButton",
        "target": "selected",
        "operation": "applications.delete",
        "config": {
          "type": "danger",
          "plain": true,
          "icon": "trash",
          "hideWhenUnavailable": true
        },
        "id": "builtin-product-6391d99c-9f5a-4f5e-8958-efc070e8c5f2"
      }
    }
  },
