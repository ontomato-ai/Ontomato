{
  "manifest": {
    "state": {
      "search": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "default": "",
        "deepLink": true
      },
      "viewing": {
        "type": {
          "kind": "object",
          "objectType": "platform:Workflow"
        }
      },
      "creating": {
        "type": {
          "kind": "scalar",
          "type": "boolean"
        },
        "default": false
      },
      "inspectingGrants": {
        "type": {
          "kind": "object",
          "objectType": "platform:Workflow"
        }
      }
    },
    "members": {
      "catalog": {
        "component": "ObjectList",
        "type": "platform:Workflow",
        "data": {
          "rows": "query"
        },
        "state": {
          "search": "search"
        },
        "operations": {
          "activate": {
            "operation": "workflows.activate",
            "target": "row"
          },
          "deactivate": {
            "operation": "workflows.deactivate",
            "target": "row"
          },
          "delete": {
            "operation": "workflows.delete",
            "target": "row"
          }
        },
        "config": {
          "layout": "table",
          "searchable": true,
          "searchPlaceholder": "searchPlaceholder",
          "emptyText": "empty",
          "noMatchText": "noMatch",
          "fallbackToFirst": false,
          "columns": [
            {
              "key": "label",
              "labelKey": "col.name",
              "subtitleKey": "subtitle",
              "minWidth": 150,
              "wrap": true
            },
            {
              "key": "statusBadges",
              "labelKey": "col.status",
              "minWidth": 76,
              "width": 84,
              "wrap": true
            },
            {
              "key": "version",
              "labelKey": "col.version",
              "width": 52
            },
            {
              "key": "stepsSummary",
              "labelKey": "col.steps",
              "minWidth": 150
            },
            {
              "key": "grantsSummary",
              "labelKey": "col.grants",
              "minWidth": 132,
              "wrap": true
            },
            {
              "key": "createdBy",
              "labelKey": "col.createdBy",
              "width": 84
            },
            {
              "key": "reviewedBy",
              "labelKey": "col.reviewedBy",
              "width": 92
            }
          ],
          "rowActions": {
            "labelKey": "col.actions",
            "width": 210,
            "minWidth": 204,
            "maxVisible": 4,
            "fixed": "right",
            "items": [
              {
                "kind": "local",
                "id": "view",
                "labelKey": "action.view",
                "icon": "eye",
                "tone": "primary"
              },
              {
                "kind": "operation",
                "operation": "activate",
                "labelKey": "action.activate",
                "icon": "play-circle",
                "when": {
                  "field": "canActivate",
                  "equals": true
                }
              },
              {
                "kind": "operation",
                "operation": "deactivate",
                "labelKey": "action.deactivate",
                "icon": "pause-circle",
                "when": {
                  "field": "canDeactivate",
                  "equals": true
                }
              },
              {
                "kind": "operation",
                "operation": "delete",
                "labelKey": "action.delete",
                "icon": "trash-2",
                "tone": "danger",
                "disabledWhen": {
                  "field": "statusCode",
                  "equals": "ACTIVE"
                }
              }
            ]
          }
        },
        "name": "Workflow catalog",
        "description": "Searchable table of domain workflows with status, version, step summary, grant summary, provenance, and row actions.",
        "id": "builtin-product-ontology-workflows-catalog"
      },
      "viewForm": {
        "component": "ObjectForm",
        "target": "viewing",
        "data": {
          "form": "form"
        },
        "operation": "platform:Workflow.save",
        "config": {
          "actions": "none"
        },
        "name": "Workflow read-only details",
        "description": "Read-only form displaying an existing workflow definition, case object mapping, and steps.",
        "id": "builtin-product-ontology-workflows-view-form"
      },
      "createForm": {
        "component": "ObjectForm",
        "type": "platform:Workflow",
        "data": {
          "createForm": "createForm"
        },
        "operation": "platform:Workflow.save",
        "config": {
          "actions": "none"
        },
        "name": "Create workflow draft form",
        "description": "Form for authoring and saving a new workflow draft through platform:Workflow.save.",
        "id": "builtin-product-ontology-workflows-create-form"
      },
      "grantsInForceTitle": {
        "component": "RecordTemplate",
        "target": "inspectingGrants",
        "data": {
          "record": "record"
        },
        "config": {
          "templateKey": "grants.inForceTitle",
          "inline": true,
          "emptyPlaceholder": ""
        },
        "name": "Effective grants revision heading",
        "description": "Displays the active revision version heading for grants currently in force.",
        "id": "builtin-product-ontology-workflows-grants-in-force-title"
      },
      "grantCaseScopedSteps": {
        "component": "ObjectList",
        "target": "inspectingGrants",
        "data": {
          "rows": "grantCaseScopedSteps"
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "fallbackToFirst": false,
          "emptyText": "grants.emptyCaseScoped",
          "columns": [
            {
              "key": "roleCode",
              "labelKey": "col.roleCode",
              "width": 160
            },
            {
              "key": "stepName",
              "labelKey": "col.stepName",
              "minWidth": 160
            },
            {
              "key": "actionName",
              "labelKey": "col.actionName",
              "minWidth": 160
            }
          ]
        },
        "name": "Case-scoped workflow steps",
        "description": "Steps authorized per run for the current assignee without writing role-level grants.",
        "id": "builtin-product-ontology-workflows-grants-case-scoped"
      },
      "grantInForce": {
        "component": "ObjectList",
        "target": "inspectingGrants",
        "data": {
          "rows": "grantInForce"
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "fallbackToFirst": false,
          "emptyText": "grants.emptyInForce",
          "columns": [
            {
              "key": "roleCode",
              "labelKey": "col.roleCode",
              "width": 180
            },
            {
              "key": "capabilities",
              "labelKey": "col.capabilities",
              "kind": "tags",
              "wrap": true,
              "minWidth": 260
            }
          ]
        },
        "name": "Effective grants in force",
        "description": "Role capability grants currently in force for this workflow's active revision.",
        "id": "builtin-product-ontology-workflows-grants-in-force"
      },
      "grantSuperseded": {
        "component": "ObjectList",
        "target": "inspectingGrants",
        "data": {
          "rows": "grantSuperseded"
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "fallbackToFirst": false,
          "emptyText": "grants.emptySuperseded",
          "columns": [
            {
              "key": "roleCode",
              "labelKey": "col.roleCode",
              "width": 180
            },
            {
              "key": "capabilities",
              "labelKey": "col.capabilities",
              "kind": "tags",
              "wrap": true,
              "minWidth": 260
            }
          ]
        },
        "name": "Superseded historical grants",
        "description": "Stored grant rows left by earlier revisions of this workflow that are no longer granted.",
        "id": "builtin-product-ontology-workflows-grants-superseded"
      },
      "grantDirect": {
        "component": "ObjectList",
        "target": "inspectingGrants",
        "data": {
          "rows": "grantDirect"
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "fallbackToFirst": false,
          "emptyText": "grants.emptyDirect",
          "columns": [
            {
              "key": "roleCode",
              "labelKey": "col.roleCode",
              "width": 180
            },
            {
              "key": "capabilities",
              "labelKey": "col.capabilities",
              "kind": "tags",
              "wrap": true,
              "minWidth": 260
            }
          ]
        },
        "name": "Direct domain grants",
        "description": "Capability grants created directly in this domain without a workflow owner.",
        "id": "builtin-product-ontology-workflows-grants-direct"
      }
    }
  },
  "content": {
