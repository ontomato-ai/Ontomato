{
  "manifest": {
    "state": {
      "search": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "default": "",
        "deepLink": true
      },
      "creating": {
        "type": {
          "kind": "scalar",
          "type": "boolean"
        },
        "default": false
      },
      "editing": {
        "type": {
          "kind": "object",
          "objectType": "platform:Trigger"
        }
      }
    },
    "members": {
      "armedStats": {
        "component": "ObjectCount",
        "type": "platform:Trigger",
        "data": {
          "rows": "armedCount"
        },
        "config": {
          "appearance": "default",
          "labelKey": "stats.armed",
          "omitWhenUnavailable": false
        },
        "name": "Armed triggers count",
        "description": "Total number of armed triggers in this domain",
        "id": "builtin-product-17ed9b9b-1469-4e9d-b7d5-2036ed4d7848"
      },
      "totalStats": {
        "component": "ObjectCount",
        "type": "platform:Trigger",
        "data": {
          "rows": "count"
        },
        "config": {
          "appearance": "default",
          "labelKey": "stats.triggers",
          "omitWhenUnavailable": false
        },
        "name": "Total triggers count",
        "description": "Total number of triggers in this domain",
        "id": "builtin-product-fe82ad9c-1ca9-4a08-8705-098741fa382b"
      },
      "triggers": {
        "component": "ObjectList",
        "type": "platform:Trigger",
        "data": {
          "rows": "query"
        },
        "state": {
          "search": "search"
        },
        "operations": {
          "disable": {
            "operation": "triggers.setStatus",
            "target": "row",
            "params": {
              "status": {
                "literal": "UNUSED"
              },
              "enabled": {
                "literal": false
              }
            }
          },
          "publish": {
            "operation": "triggers.setStatus",
            "target": "row",
            "params": {
              "status": {
                "literal": "PUBLISHED"
              },
              "enabled": {
                "literal": true
              }
            }
          },
          "remove": {
            "operation": "triggers.delete",
            "target": "row"
          }
        },
        "config": {
          "layout": "table",
          "searchable": false,
          "emptyText": "list.empty",
          "noMatchText": "list.noMatch",
          "columns": [
            {
              "key": "triggerTitle",
              "labelKey": "col.trigger",
              "listSeparator": " ",
              "minWidth": 180
            },
            {
              "key": "effect",
              "labelKey": "col.effect",
              "minWidth": 220
            },
            {
              "key": "conditionKind",
              "labelKey": "col.condition",
              "emptyKey": "col.emptyDash",
              "minWidth": 130
            },
            {
              "key": "cadence",
              "labelKey": "col.cadence",
              "emptyKey": "col.emptyDash",
              "minWidth": 130
            },
            {
              "key": "nextRunAt",
              "labelKey": "col.nextRunAt",
              "kind": "time",
              "timeFormat": "datetime",
              "emptyKey": "col.emptyDash",
              "minWidth": 160
            },
            {
              "key": "status",
              "labelKey": "col.status",
              "kind": "tag",
              "width": 120
            }
          ],
          "rowActions": {
            "labelKey": "col.actions",
            "width": 180,
            "align": "left",
            "maxVisible": 3,
            "items": [
              {
                "kind": "local",
                "id": "edit",
                "labelKey": "action.edit",
                "icon": "pencil",
                "iconOnly": true
              },
              {
                "kind": "operation",
                "operation": "disable",
                "labelKey": "action.disable",
                "when": {
                  "field": "statusCode",
                  "equals": "PUBLISHED"
                }
              },
              {
                "kind": "operation",
                "operation": "publish",
                "labelKey": "action.publish",
                "when": {
                  "field": "statusCode",
                  "notEquals": "PUBLISHED"
                }
              },
              {
                "kind": "operation",
                "operation": "remove",
                "labelKey": "action.delete",
                "icon": "trash-2",
                "iconOnly": true,
                "tone": "danger"
              }
            ]
          }
        },
        "name": "Triggers table",
        "description": "Domain triggers with schedule, effect, status, and inline edit, publish/disable, and delete actions",
        "id": "builtin-product-1d6a36f2-967a-4887-a486-dfafaf572a3f"
      },
      "createForm": {
        "component": "ObjectForm",
        "type": "platform:Trigger",
        "data": {
          "createForm": "createForm"
        },
        "operation": "platform:Trigger.save",
        "config": {
          "actions": "none"
        },
        "name": "New trigger form",
        "description": "Owner-declared form for creating a trigger",
        "id": "builtin-product-13889715-c2a0-4896-9d97-fc120574c8cb"
      },
      "editForm": {
        "component": "ObjectForm",
        "target": "editing",
        "data": {
          "form": "form"
        },
        "operation": "platform:Trigger.save",
        "config": {
          "actions": "none"
        },
        "name": "Edit trigger form",
        "description": "Owner-declared form for editing the selected trigger",
        "id": "builtin-product-b78eb7d4-afab-4057-bd9b-7bda80cb46da"
      }
    }
  },
