{
  "manifest": {
    "state": {
      "viewMode": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": "graph"
      },
      "selectedClass": {
        "type": {
          "kind": "object",
          "objectType": "platform:ObjectType"
        },
        "deepLink": true
      },
      "selectedNode": {
        "type": {
          "kind": "object",
          "objectType": "@any"
        }
      },
      "graphStart": {
        "type": {
          "kind": "object",
          "objectType": "@any"
        }
      },
      "search": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true,
        "default": ""
      },
      "graphQuery": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "default": ""
      },
      "graphSearchClass": {
        "type": {
          "kind": "object",
          "objectType": "platform:ObjectType"
        }
      },
      "graphSearchClassName": {
        "type": {
          "kind": "scalar",
          "type": "string"
        }
      },
      "graphVersion": {
        "type": {
          "kind": "scalar",
          "type": "string"
        }
      },
      "positions": {
        "type": {
          "kind": "json"
        },
        "personal": true
      },
      "expandedNodes": {
        "type": {
          "kind": "list",
          "items": {
            "kind": "object",
            "objectType": "@any"
          }
        }
      },
      "visibleRelationKinds": {
        "type": {
          "kind": "list",
          "items": {
            "kind": "scalar",
            "type": "string"
          }
        }
      },
      "neighborFilter": {
        "type": {
          "kind": "json"
        }
      },
      "filters": {
        "type": {
          "kind": "json"
        }
      },
      "sort": {
        "type": {
          "kind": "json"
        }
      }
    },
    "members": {
      "instanceGraph": {
        "component": "OntologyGraph",
        "name": "Instance relationship graph",
        "description": "Sampled overview and paginated one-hop neighborhood graph of domain object instances with per-person saved node positions.",
        "type": "platform:ObjectType",
        "data": {
          "overview": "instanceGraphOverview",
          "connections": "instanceGraphConnections",
          "counts": "instanceGraphStatistics",
          "neighbors": "instanceNeighbors"
        },
        "inputs": {
          "selected": {
            "state": "selectedNode"
          }
        },
        "state": {
          "start": "graphStart",
          "selectedNode": "selectedNode",
          "selectedGroup": "graphSearchClassName",
          "query": "graphQuery",
          "positions": "positions",
          "expandedNodes": "expandedNodes",
          "visibleRelationKinds": "visibleRelationKinds",
          "neighborFilter": "neighborFilter"
        },
        "config": {
          "fitMode": "fit",
          "expandOn": "activate",
          "showLayerFilter": false,
          "showLegend": false,
          "showToolbar": true,
          "showNeighborControls": false
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000001"
      },
      "graphSearchClassPicker": {
        "component": "ReferencePicker",
        "name": "Graph search class filter",
        "description": "Optional object type filter narrowing instance graph search results.",
        "type": "platform:ObjectType",
        "data": {
          "rows": "instanceGraphClasses"
        },
        "state": {
          "selected": "graphSearchClass"
        },
        "config": {
          "placeholderKey": "db.allClasses",
          "clearable": true,
          "size": "default",
          "metaField": "instanceCount"
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000002"
      },
      "graphSearchResults": {
        "component": "ObjectList",
        "name": "Instance graph search results",
        "description": "Matches instances in the current graph snapshot by keyword and optional object type.",
        "type": "platform:ObjectType",
        "data": {
          "rows": {
            "read": "instanceGraphSearch",
            "params": {
              "search": {
                "state": "graphQuery"
              },
              "className": {
                "state": "graphSearchClassName"
              },
              "version": {
                "state": "graphVersion"
              }
            }
          }
        },
        "config": {
          "layout": "list",
          "subtitleField": "classLabel",
          "searchable": false,
          "showFooter": false,
          "showChevron": false,
          "emptyText": "db.graphSearchEmpty"
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000003"
      },
      "nodeHeader": {
        "component": "ObjectHeader",
        "name": "Selected instance title",
        "description": "Displays the selected graph instance's name in the inspector drawer.",
        "type": "platform:ObjectType",
        "data": {
          "record": {
            "read": "instanceRecord",
            "params": {
              "object": {
                "state": "selectedNode"
              }
            }
          }
        },
        "config": {
          "subtitle": "",
          "fallbackTitle": ""
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000004"
      },
      "nodeSummary": {
        "component": "ObjectSummary",
        "name": "Selected instance attributes",
        "description": "Quick read-only attribute overview of the selected graph instance.",
        "type": "platform:ObjectType",
        "data": {
          "record": {
            "read": "instanceRecord",
            "params": {
              "object": {
                "state": "selectedNode"
              }
            }
          }
        },
        "config": {
          "showTitle": false,
          "density": "compact",
          "emptyText": "db.nodeSummaryEmpty",
          "missingText": "db.nodeSummaryMissing"
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000005"
      },
      "classPicker": {
        "component": "ReferencePicker",
        "name": "Object type selector",
        "description": "Searchable dropdown to switch the active object type in table mode.",
        "type": "platform:ObjectType",
        "data": {
          "rows": "list"
        },
        "state": {
          "selected": "selectedClass"
        },
        "config": {
          "placeholderKey": "db.selectClass",
          "clearable": false,
          "size": "default"
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000006"
      },
      "classCatalogProbe": {
        "component": "ObjectList",
        "name": "Default object type selector probe",
        "description": "Selects the first available object type automatically when entering table mode without a selected class.",
        "type": "platform:ObjectType",
        "data": {
          "rows": "list"
        },
        "state": {
          "selected": "selectedClass"
        },
        "config": {
          "layout": "list",
          "fallbackToFirst": true,
          "searchable": false,
          "showFooter": false
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000007"
      },
      "classAttributesProbe": {
        "component": "ObjectList",
        "name": "Selected class attributes probe",
        "description": "Loads the selected object type's attributes for filter and sort field selectors.",
        "type": "platform:Attribute",
        "data": {
          "rows": {
            "read": "list",
            "params": {
              "className": {
                "state": "selectedClass",
                "field": "primaryKey"
              }
            }
          }
        },
        "config": {
          "layout": "list",
          "searchable": false,
          "showFooter": false
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000008"
      },
      "instanceTable": {
        "component": "ObjectList",
        "name": "Object instance records table",
        "description": "Server-filtered, server-sorted, paginated multi-column table of object instances with dynamic columns, column visibility toggle, and current-page CSV export.",
        "type": "platform:ObjectType",
        "data": {
          "rows": {
            "read": "instances",
            "params": {
              "className": {
                "state": "selectedClass",
                "field": "primaryKey"
              },
              "filters": {
                "state": "filters"
              },
              "sort": {
                "state": "sort"
              }
            }
          }
        },
        "state": {
          "search": "search"
        },
        "config": {
          "layout": "table",
          "dynamicColumns": true,
          "showColumnToggle": true,
          "exportable": true,
          "searchable": false,
          "showChevron": false,
          "showRowIndex": true,
          "pinPrimaryColumn": true,
          "rowActivation": "dblclick",
          "showRangeBar": true,
          "emptyText": "db.tableEmpty",
          "noMatchText": "db.tableNoMatch",
          "pagination": "pages",
          "pageSizes": [
            20,
            50,
            100
          ]
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000009"
      },
      "detailBinding": {
        "component": "InfoBanner",
        "name": "Detail panel permission probe",
        "description": "Reads whether the current user can configure this object type's detail presentation.",
        "target": "selectedClass",
        "data": {
          "record": "detailPanel"
        },
        "config": {
          "field": "unavailableReason",
          "hideWhenEmpty": true
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000010"
      },
      "detailBindingSummary": {
        "component": "ObjectSummary",
        "name": "Current detail panel binding",
        "description": "Displays the currently configured detail panel status and name inside the presentation dialog.",
        "target": "selectedClass",
        "data": {
          "record": "detailPanel"
        },
        "config": {
          "showTitle": false,
          "fields": [
            "status",
            "panelName",
            "unavailableReason"
          ]
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000011"
      },
      "detailPanelForm": {
        "component": "ObjectForm",
        "name": "Configure detail panel form",
        "description": "Selects or clears the custom detail panel bound to this object type.",
        "target": "selectedClass",
        "data": {
          "form": "detailPanelForm"
        },
        "operation": "platform:ObjectType.saveDetailPanel",
        "config": {
          "actions": "footer"
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000012"
      },
      "detailPanelPicker": {
        "component": "ReferencePicker",
        "name": "Detail panel picker",
        "description": "Searches and picks a usable panel to bind as this object type's detail panel.",
        "type": "platform:ProductPanel",
        "data": {
          "options": "options"
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000013"
      },
      "clearDetailPanel": {
        "component": "OperationButton",
        "name": "Restore default detail",
        "description": "Clears the custom detail panel binding so the object type falls back to the built-in read-only detail.",
        "operation": "objectTypes.clearDetailPanel",
        "target": "selectedClass",
        "config": {
          "plain": true,
          "labelKey": "db.restoreDefault"
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000014"
      },
      "classNamesProbe": {
        "component": "ObjectList",
        "name": "Object type display labels probe",
        "description": "Populates object type display names for graph inspector and class scope labels.",
        "type": "platform:ObjectType",
        "data": {
          "rows": "list"
        },
        "config": {
          "layout": "list",
          "searchable": false,
          "showFooter": false
        },
        "id": "builtin-product-9f3c1e20-4b7d-4e92-a814-000000000015"
      }
    }
  },
