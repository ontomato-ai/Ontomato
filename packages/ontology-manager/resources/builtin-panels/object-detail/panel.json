{
  "manifest": {
    "state": {
      "selected": {
        "type": {
          "kind": "object",
          "objectType": "@any"
        },
        "deepLink": true,
        "external": true
      },
      "returnTo": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "deepLink": true
      },
      "selectedClass": {
        "type": {
          "kind": "object",
          "objectType": "platform:ObjectType"
        }
      }
    },
    "members": {
      "headerTitle": {
        "component": "ObjectHeader",
        "name": "Object title",
        "description": "Displays the selected object's primary display name in the page header.",
        "type": "platform:ObjectType",
        "data": {
          "record": {
            "read": "instanceRecord",
            "params": {
              "object": {
                "state": "selected"
              }
            }
          }
        },
        "config": {
          "subtitle": "",
          "fallbackTitle": ""
        },
        "id": "builtin-product-8e2d0b41-7c3a-4b1e-9a02-000000000001"
      },
      "detailBinding": {
        "component": "InfoBanner",
        "name": "Detail panel permission probe",
        "description": "Reads whether the current user can configure this object type's detail panel.",
        "target": "selectedClass",
        "data": {
          "record": "detailPanel"
        },
        "config": {
          "field": "unavailableReason",
          "hideWhenEmpty": true
        },
        "id": "builtin-product-8e2d0b41-7c3a-4b1e-9a02-000000000002"
      },
      "detailBindingSummary": {
        "component": "ObjectSummary",
        "name": "Current detail panel binding",
        "description": "Displays the currently configured detail panel status and name inside the presentation dialog.",
        "target": "selectedClass",
        "data": {
          "record": "detailPanel"
        },
        "config": {
          "showTitle": false,
          "fields": [
            "status",
            "panelName",
            "unavailableReason"
          ]
        },
        "id": "builtin-product-8e2d0b41-7c3a-4b1e-9a02-000000000003"
      },
      "detailPanelForm": {
        "component": "ObjectForm",
        "name": "Configure detail panel form",
        "description": "Selects or clears the custom detail panel bound to this object type.",
        "type": "platform:ObjectType",
        "target": "selectedClass",
        "data": {
          "form": "detailPanelForm"
        },
        "operation": "platform:ObjectType.saveDetailPanel",
        "config": {
          "actions": "footer"
        },
        "id": "builtin-product-8e2d0b41-7c3a-4b1e-9a02-000000000004"
      },
      "detailPanelPicker": {
        "component": "ReferencePicker",
        "name": "Detail panel picker",
        "description": "Searches and picks a usable panel to bind as this object type's detail panel.",
        "type": "platform:ProductPanel",
        "data": {
          "options": "options"
        },
        "id": "builtin-product-8e2d0b41-7c3a-4b1e-9a02-000000000005"
      },
      "clearDetailPanel": {
        "component": "OperationButton",
        "name": "Restore default detail",
        "description": "Clears the custom detail panel binding so the object type falls back to the built-in read-only detail.",
        "operation": "objectTypes.clearDetailPanel",
        "target": "selectedClass",
        "config": {
          "plain": true,
          "labelKey": "od.restoreDefault"
        },
        "id": "builtin-product-8e2d0b41-7c3a-4b1e-9a02-000000000006"
      },
      "favoriteStatus": {
        "component": "InfoBanner",
        "name": "Favorite state",
        "description": "Reads whether the currently viewed object is in the reader's personal favorites.",
        "type": "platform:Favorite",
        "data": {
          "record": {
            "read": "status",
            "params": {
              "object": {
                "state": "selected"
              }
            }
          }
        },
        "config": {
          "field": "status",
          "hideWhenEmpty": true
        },
        "id": "builtin-product-8e2d0b41-7c3a-4b1e-9a02-000000000007"
      },
      "addFavorite": {
        "component": "PanelData",
        "name": "Add object to favorites",
        "description": "Pins the selected object to the reader's personal favorites.",
        "type": "platform:Favorite",
        "target": "selected",
        "operation": "favorites.add",
        "id": "builtin-product-8e2d0b41-7c3a-4b1e-9a02-000000000008"
      },
      "removeFavorite": {
        "component": "PanelData",
        "name": "Remove object from favorites",
        "description": "Removes the selected object from the reader's personal favorites.",
        "type": "platform:Favorite",
        "target": "selected",
        "operation": "favorites.remove",
        "id": "builtin-product-8e2d0b41-7c3a-4b1e-9a02-000000000009"
      },
      "body": {
        "target": {
          "panelId": "builtin-product-object-detail-body"
        },
        "inputs": {
          "selected": {
            "state": "selected"
          }
        },
        "outputs": {
          "selected": {
            "state": "selected"
          }
        }
      }
    }
  },
