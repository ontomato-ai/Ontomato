{
  "name": "ontomato",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "node scripts/dev-command.mjs dev",
    "dev:server": "node scripts/dev-command.mjs server",
    "dev:web": "node scripts/dev-command.mjs web",
    "dev:ontology-manager": "node scripts/dev-command.mjs manager",
    "dev:up": "node scripts/dev-stack.mjs . up",
    "dev:down": "node scripts/dev-stack.mjs . down",
    "dev:status": "node scripts/dev-stack.mjs . status",
    "dev:logs": "node scripts/dev-stack.mjs . logs",
    "typecheck:workbench": "pnpm --filter @ontomato/contracts --filter @ontomato/workbench-server --filter @ontomato/workbench typecheck",
    "test:workbench": "pnpm --filter @ontomato/workbench-server --filter @ontomato/workbench test",
    "lint:workbench": "eslint packages/contracts packages/workbench-server apps/workbench",
    "test:scripts": "node --test \"scripts/**/*.node-test.mjs\" \"apps/*/*.node-test.mjs\"",
    "lint:scripts": "eslint scripts \"apps/*/*.mjs\" agent-skills",
    "dev:agent-runtime": "node scripts/dev-command.mjs runtime",
    "typecheck:runtime": "pnpm --filter @ontomato/contracts --filter @ontomato/agent-runtime --filter @ontomato/agent-runtime-app typecheck",
    "test:runtime": "pnpm --filter @ontomato/agent-runtime test",
    "test:integration": "pnpm --filter @ontomato/agent-runtime test:integration && pnpm --filter @ontomato/workbench-server test:integration",
    "test:java:contract": "./mvnw -B -ntp -pl packages/data-engine-core -am -Dtest='ServiceLogContractTest,ServiceLogJdbcTest,OntologyRetrievalContractTest,OntologyGenerationContractTest,QueryRuntimeBoundaryTest,BusinessConfigControllerModelKeyWriteOnlyTest,MetadataPostgresBoundaryTest,VectorResourcePostgresBoundaryTest,AssetLookupPostgresBoundaryTest,KnowledgeDomainPostgresBoundaryTest,AbsJdbcBaseDaoIdTest,OssStartupAssemblyTest' -Dsurefire.failIfNoSpecifiedTests=false test",
    "test:sandbox": "pnpm --filter @ontomato/agent-runtime test:sandbox",
    "test:wire": "pnpm --filter @ontomato/workbench-server test:wire"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "concurrently": "9.2.1",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.8.0",
    "globals": "17.4.0",
    "typescript": "5.9.3",
    "vue-eslint-parser": "10.4.0",
    "yaml": "2.8.3"
  }
}
