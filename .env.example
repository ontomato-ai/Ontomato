# Copy to .env. Node, Java and the manager share this file; process variables take priority.

# Node → DataRAG, also the Ontology Manager's development proxy target, so the workbench
# login and the Manager always reach the same data engine (point both at a remote engine by
# changing this one line). There is no built-in default, so it must be set. Set
# DATARAG_ORIGIN only when the Manager must reach a different engine.
DATA_QUERY_BASE_URL=http://localhost:18087
POSTGRES_USER=ontomato
POSTGRES_PASSWORD=ontomato
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18087
SERVICE_ID=local-dev
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# The system MCP is empty by default.
# MCP_SERVER_URL=

# Configure models in Model Configuration; Node reads the data engine's model settings.

# dev/dev:up starts the public runtime on port 3001 before the workbench.
# Service credentials are generated in .secrets/agent-runtime.env unless supplied here.
# AGENT_RUNTIME_PORT=3001
# AGENT_RUNTIME_DATABASE_URL=

# Shared by Node and Java, which both refuse to start without it. Saved model API keys are write-only: reads show
# masks, and Java hands the keys to Node encrypted with this value, so a browser never gets them.
# The value below is a public development sample, not a secret; every environment needs its own random value.
ONTOMATO_MODEL_RUNTIME_TOKEN=ontomato-development-model-runtime-change-me
