# Copy to .env and replace the placeholders. No real secrets.

# Target image architecture.
ARCH=amd64

# 1. Required. Without these the stack does not start, or the browser cannot open it.
POSTGRES_PASSWORD=change-me
# Shared by the workbench and the data engine; the saved model API keys pass between them encrypted with it.
# Generate one per deployment, for example: openssl rand -hex 24
ONTOMATO_MODEL_RUNTIME_TOKEN=change-me
# The address the browser uses to reach this server: an IP address or a hostname.
PUBLIC_HOST=127.0.0.1

# Optional. Each entry below has a default; uncomment one to override it.
# Container ports are fixed: Node 3000, the manager 80, DataRAG 18087, PostgreSQL 5432.
# PORT=3000
# ONTOLOGY_MANAGER_PORT=3005
# DATARAG_PORT=18087
# POSTGRES_PORT=5432
# TZ=UTC
# COMPOSE_PROJECT_NAME=ontomato
# To deploy from GitHub Container Registry, uncomment COMPOSE_FILE; ONTOMATO_VERSION picks the
# release to pull, such as 4.0.0-beta.1, and defaults to latest.
# COMPOSE_FILE=docker-compose.yml:docker-compose.ghcr.yml
# ONTOMATO_VERSION=latest
# To follow a tag automatically (for example edge on a development server), append
# :docker-compose.autoupdate.yml to COMPOSE_FILE; see Automatic updates in README.md.
# ONTOLOGY_INITIAL_ROUTE=/playground
# Defaults to http://PUBLIC_HOST:ONTOLOGY_MANAGER_PORT; override it for a domain or reverse proxy.
# ONTOLOGY_MANAGER_URL=

# Only when this deployment serves as the test environment of the
# ontomato-app-builder skill: the production backend URL (for example
# http://prod-host:18087) and an account used to log in to it;
# leave the account empty when production is an open-source deployment.
# PRODUCTION_ENV_URL=
# PRODUCTION_ENV_USER=
# PRODUCTION_ENV_PASSWORD=

# Generated once by deployment preparation; shared by workbench and runtime.
# AGENT_RUNTIME_SERVICE_TOKEN=
# AGENT_RUNTIME_ONTOLOGY_TOKEN=
# ONTOMATO_QUERY_SERVICE_TOKEN=
# ONTOMATO_QUERY_SIGNING_KEY=
