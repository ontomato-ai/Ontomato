# Full deployment configuration reference. Required entries are marked below; the installer writes actual values.
# Keep the site .env when installing a new version; this template does not migrate existing settings.
# Copy to .env and replace the placeholders. No real secrets.

# Target image architecture.
# ARCH=amd64

# 1. Required. Without these the stack does not start, or the browser cannot open it.
# POSTGRES_PASSWORD=change-me
# The address the browser uses to reach this server: an IP address or a hostname.
# PUBLIC_HOST=127.0.0.1

# Optional. Each entry below has a default; uncomment one to override it.
# Container ports are fixed: Node 3000, the manager 80, DataRAG 18087, PostgreSQL 5432.
# PORT=3000
# ONTOLOGY_MANAGER_PORT=3005
# DATARAG_PORT=18087
# POSTGRES_PORT=5432
# TZ=UTC
# COMPOSE_PROJECT_NAME=ontomato
# To deploy from GitHub Container Registry, uncomment COMPOSE_FILE; ONTOMATO_VERSION picks the
# release to pull, such as 4.0.0-beta.1, and defaults to latest.
# COMPOSE_FILE=docker-compose.yml:docker-compose.ghcr.yml
# ONTOMATO_VERSION=latest
# To follow a tag automatically (for example edge on a development server), append
# :docker-compose.autoupdate.yml to COMPOSE_FILE; see Automatic updates in README.md.
# ONTOLOGY_INITIAL_ROUTE=/playground
# Defaults to http://PUBLIC_HOST:ONTOLOGY_MANAGER_PORT; override it for a domain or reverse proxy.
# ONTOLOGY_MANAGER_URL=

# Only when this deployment serves as the test environment of the
# ontomato-app-builder skill: the production backend URL (for example
# http://prod-host:18087) and an account used to log in to it;
# leave the account empty when production is an open-source deployment.
# PRODUCTION_ENV_URL=
# PRODUCTION_ENV_USER=
# PRODUCTION_ENV_PASSWORD=


# Application options. Uncomment only values this deployment needs to override.
# Scheduling time zone; defaults to the container time zone.
# SCHEDULE_TIMEZONE=Asia/Shanghai
# Log verbosity and the workbench log directory (container paths).
# LOG_LEVEL=info
# ONTOMATO_LOG_DIR=/app/data/logs
# Reverse-proxy API prefix; route this prefix to the workbench API.
# API_BASE=/api
# Per-request data-engine timeout in milliseconds.
# DATA_QUERY_TIMEOUT=30000
# PostgreSQL schema for workbench tables. Set before initialization.
# PG_SCHEMA=public
# Explicit workbench DB connection override (takes precedence over POSTGRES_*).
# DATABASE_URL=postgresql://user:password@host:5432/database
# Legacy alias for DATABASE_URL; use only one of the two.
# PG_CONNECTION_STRING=
# Data engine JDBC override; required together when using a different database backend.
# DATA_ENGINE_JDBC_URL=
# DATA_ENGINE_JDBC_DRIVER=org.postgresql.Driver
# Stable data-engine service and node IDs; use distinct IDs for multiple nodes.
# SERVICE_ID=
# NODE_ID=
# Public base URL used in generated card/resource links.
# CARD_BASE_URL=

# SMTP for scheduled delivery. Empty SMTP_HOST disables mail transport.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# New-domain model defaults. Existing domain model settings are maintained in the product UI.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=2048
# Default adapter for a new domain; existing domains keep their own configuration.
# DATA_ADAPTER=postgresql

# MCP integration; no need to configure the application-internal service addresses.
# MCP_SERVER_URL=
# ANALYSIS_AGENT_MCP_URL=
# ANALYSIS_AGENT_MCP_TASK_TIMEOUT_MS=
# Interval between subqueries / cooldown between report generations, in milliseconds.
# SUB_QUESTION_QUERY_INTERVAL_MS=0
# REPORT_GENERATION_COOLDOWN_MS=0
# Program replay and browser rendering overrides (container paths).
# ABC_REPLAY_PYTHON_COMMAND=python3
# ABC_REPLAY_DIR=
# CHROMIUM_EXECUTABLE_PATH=
# Diagnostics retention policy file, backend nodes and trace directories.
# DIAGNOSIS_RETENTION_FILE=
# OBSERVE_BACKEND_NODES=
# OBSERVE_BACKEND_INFO_BUCKET_ROOT=
# OBSERVE_TRACE_WORKSPACE_ROOT=

# Advanced API integration. Standard product deployments keep these defaults.
# DATA_QUERY_API_KEY=
# DATA_QUERY_SPLIT_ENDPOINT=/streamSplitQuestion
# DATA_QUERY_STREAM_ENDPOINT=/streamchatV1
# DATA_QUERY_STREAM_DEEP_ENDPOINT=/streamchatV1Deep
# DATA_QUERY_CHECK_ENDPOINT=/check/queryBySessionId
# DATA_QUERY_METRIC_VIEW_STATIC_ENDPOINT=/metricView/generateStaticContent
# DATA_QUERY_METRIC_VIEW_GENERAL_ENDPOINT=/metricView/generateGeneralContent
# DATA_QUERY_FIND_KNOWLEDGE_ENDPOINT=/knowledge/findknowledge
# DATA_QUERY_GET_NODE_IDS_ENDPOINT=/dsl/getNodeIds

# Exact image overrides. Normally written by the installer; all application images must match.
# WORKBENCH_IMAGE=
# DATA_ENGINE_IMAGE=
# MANAGER_IMAGE=
# POSTGRES_IMAGE=
# The supplied Compose topology fixes internal DB/service hosts, users and container ports.
# Changing POSTGRES_HOST, POSTGRES_USER, DATA_QUERY_BASE_URL or DATARAG_ORIGIN here cannot
# override explicit Compose environment entries; a different topology requires editing Compose.

# Process memory overrides. Leave unset to use each image's runtime defaults.
# NODE_OPTIONS=--max-old-space-size=4096
# JAVA_TOOL_OPTIONS=-Xmx4g
