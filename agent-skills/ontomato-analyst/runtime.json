{
  "version": "2.0.0",
  "tools": [
    {
      "name": "ontology_overview",
      "description": "Read the dataset description and class list.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "entry": "runtime.mjs"
    },
    {
      "name": "ontology_schema",
      "description": "Read classes and their direct relationships.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "classNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "classNames"
        ],
        "additionalProperties": false
      },
      "entry": "runtime.mjs"
    },
    {
      "name": "ontology_dsl_reference",
      "description": "Get the authoritative DSL grammar and worked example for these classes before writing DSL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "classNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "classNames"
        ],
        "additionalProperties": false
      },
      "entry": "runtime.mjs"
    },
    {
      "name": "ontology_distinct_values",
      "description": "Probe real string values using the bound authorization.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "className": {
            "type": "string"
          },
          "attribute": {
            "type": "string"
          },
          "like": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "className",
          "attribute",
          "limit"
        ],
        "additionalProperties": false
      },
      "entry": "runtime.mjs"
    },
    {
      "name": "ontology_execute_dsl",
      "description": "Execute one read DSL object, or read it from a workspace JSON path. A preview is not formal output.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dsl": {
            "type": "object"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "entry": "runtime.mjs"
    },
    {
      "name": "ontology_find_metrics",
      "description": "Find published read metric specifications without a model call.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "classNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "query",
          "limit"
        ],
        "additionalProperties": false
      },
      "entry": "runtime.mjs"
    },
    {
      "name": "ontology_execute_metric",
      "description": "Execute a published metric with explicit parameters and its pinned revision.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "revision",
          "parameters"
        ],
        "additionalProperties": false
      },
      "entry": "runtime.mjs"
    },
    {
      "name": "ontology_find_knowledge",
      "description": "Find relevant business knowledge.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "query",
          "limit"
        ],
        "additionalProperties": false
      },
      "entry": "runtime.mjs"
    }
  ]
}
