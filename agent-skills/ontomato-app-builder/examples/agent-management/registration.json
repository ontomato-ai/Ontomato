  "panels": [
    {
      "id": "app-example-agent-management",
      "mode": "create",
      "input": {
        "name": "Agent Definition",
        "description": "",
        "visibility": "domain",
        "manifest": {
          "state": {
            "selected": {
              "type": {
                "kind": "object",
                "objectType": "platform:AgentDefinition"
              },
              "deepLink": true
            }
          },
          "members": {
            "list": {
              "target": {
                "projectionId": "app-example-agent-management-list"
              },
              "inputs": {
                "selected": {
