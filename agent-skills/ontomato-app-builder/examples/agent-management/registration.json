                }
              }
            },
            "form": {
              "target": {
                "projectionId": "app-example-agent-management-form"
              },
              "inputs": {
                "item": {
                  "state": "selected"
                }
              }
            }
          },
          "events": {}
        },
        "content": {
          "html": "<style>\n  .management { display: grid; gap: 1rem; }\n  .management-toolbar { display: flex; flex-wrap: wrap; gap: .75rem; }\n  .management-body { display: grid; gap: 1rem; }\n  .management-columns { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }\n  .management-detail { display: grid; gap: 1rem; align-content: start; }\n  @media (max-width: 36rem) { .management-columns { grid-template-columns: minmax(0, 1fr); } }\n</style>\n<div id=\"app\">\n  <section class=\"management\">\n    <div class=\"management-toolbar\">\n      <button type=\"button\" @click=\"newRecord\">New</button>\n    </div>\n    <div class=\"management-body management-columns\">\n      <projection slot=\"list\" @update:selected=\"stopCreating\"></projection>\n      <div class=\"management-detail\">\n        <projection slot=\"detail\" v-if=\"selected\"></projection>\n        <projection slot=\"form\" v-if=\"selected || creating\"></projection>\n      </div>\n    </div>\n  </section>\n</div>\n",
          "module": "import { computed, ref } from \"vue\";\nimport { mountPanel, usePanelContext } from \"@ontomato/sdk/panel\";\n\nawait mountPanel({\n  setup() {\n    const { instance } = usePanelContext();\n    const selected = computed(() => instance.state.values.value.selected);\n    const creating = ref(false);\n    function newRecord() {\n      creating.value = true;\n      instance.state.set(\"selected\", null);\n    }\n    function stopCreating() {\n      creating.value = false;\n    }\n    return { selected, creating, newRecord, stopCreating };\n  },\n});\n"
        }
      }
    }
  ],
