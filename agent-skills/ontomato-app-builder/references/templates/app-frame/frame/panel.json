{
  "manifest": {
    "state": {
      "term": {
        "type": {
          "kind": "scalar",
          "type": "string"
        },
        "default": "2026-fall",
        "deepLink": true,
        "external": true
      }
    },
    "members": {
      "content": {
        "target": {
          "fromPlatform": "currentEntry",
          "candidates": {
            "rule": "applicationEntry"
          }
        }
      },
      "courses": {
        "component": "ObjectCount",
        "type": "Course",
        "data": {
          "rows": {
            "read": "query",
            "params": {
              "search": {
                "state": "term"
              }
            }
          }
        },
        "config": {
          "appearance": "badge"
        }
      },
      "enrollments": {
        "component": "ObjectCount",
        "type": "Enrollment",
        "data": {
          "rows": {
            "read": "query",
            "params": {
              "search": {
                "state": "term"
              }
            }
          }
        },
        "config": {
          "appearance": "badge"
        }
      }
    }
  },
  "content": {
    "messages": {
      "en": {
        "panel.name": "Academic planner",
        "term.label": "Academic term",
        "term.fall": "Fall 2026",
        "term.spring": "Spring 2027"
      }
    }
  }
}
