{
  "panels": [
    {
      "id": "template-academic-frame",
      "mode": "create",
      "input": {
        "name": "Academic planner frame",
        "description": "Academic navigation and term selection",
        "visibility": "domain"
      }
    }
  ],
  "applications": [
    {
      "id": "app-academic-planner",
      "mode": "create",
      "input": {
        "entry": {
          "path": "/applications/app-academic-planner/courses",
