{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts",
    "../src/__tests__/integration/**/*.ts",
    "../../../packages/workbench-ui/src/env.d.ts",
    "../../../packages/apps-sdk/src/env.d.ts"
  ]
}
