; Extend the installed container-selinux domain for the runtime's nested mounts.
(type ontomato_agent_runtime_t)
(typeattributeset domain (ontomato_agent_runtime_t))
(typeattributeset container_domain (ontomato_agent_runtime_t))
(typeattributeset mcs_constrained_type (ontomato_agent_runtime_t))
(roletype system_r ontomato_agent_runtime_t)
(allow ontomato_agent_runtime_t self (capability (sys_admin net_admin sys_chroot)))
(allow ontomato_agent_runtime_t proc_t (filesystem (mount remount unmount)))
(allow ontomato_agent_runtime_t tmpfs_t (filesystem (mount remount unmount)))
(allow ontomato_agent_runtime_t container_file_t (dir (mounton)))
(allow ontomato_agent_runtime_t container_file_t (file (mounton)))
(allow ontomato_agent_runtime_t container_file_t (chr_file (mounton)))
(allow ontomato_agent_runtime_t container_file_t (filesystem (remount)))
(allow container_file_t proc_t (filesystem (associate)))
