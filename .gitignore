apps/data-engine/.dev/
apps/data-engine/.venv/
packages/data-engine-core/.classpath
packages/data-engine-core/.project
packages/data-engine-core/.settings/
packages/data-adapters/*/.classpath
packages/data-adapters/*/.project
packages/data-adapters/*/.settings/

# Local service credentials generated by dev:up.
/.secrets/
